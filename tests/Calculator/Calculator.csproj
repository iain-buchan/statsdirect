<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType><TargetFramework>net10.0-windows10.0.17763.0</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms><ImplicitUsings>enable</ImplicitUsings>
    <StatsDirectBin Condition="'$(StatsDirectBin)' == ''">../../StatsDirectUI/bin/Release/net10.0-windows10.0.17763.0</StatsDirectBin>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4258.31" />
    <Reference Include="StatsDirect"><HintPath>$(StatsDirectBin)/StatsDirect.dll</HintPath></Reference>
    <Compile Include="../../StatsDirectUI/Calculator/CalculatorView.cs;../../StatsDirectUI/Calculator/ExpressionEditor.cs;../../StatsDirectUI/Calculator/CalculatorService.cs;../../StatsDirectUI/UI/ToolWindows/*.cs;../../StatsDirectUI/UI/HtmlHelp/*.cs" Link="Production/%(Filename)%(Extension)" />
    <Content Include="../../StatsDirectUI/Assets/Help/**" Exclude="../../StatsDirectUI/Assets/Help/**/*.output;../../StatsDirectUI/Assets/Help/**/*.log.zip" Link="Help/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <Target Name="RemoveUnusedWebView2WpfReference" BeforeTargets="ResolveAssemblyReferences"><ItemGroup><Reference Remove="@(Reference)" Condition="'%(Reference.Filename)' == 'Microsoft.Web.WebView2.Wpf'" /></ItemGroup></Target>
</Project>
