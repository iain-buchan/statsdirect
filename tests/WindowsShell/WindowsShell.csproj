<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType><TargetFramework>net10.0-windows10.0.17763.0</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms><ImplicitUsings>enable</ImplicitUsings>
    <StatsDirectBin Condition="'$(StatsDirectBin)' == ''">../../StatsDirectUI/bin/Release/net10.0-windows10.0.17763.0</StatsDirectBin>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="StatsDirect"><HintPath>$(StatsDirectBin)/StatsDirect.dll</HintPath></Reference>
    <Reference Include="SpreadsheetGear"><HintPath>$(StatsDirectBin)/SpreadsheetGear.dll</HintPath></Reference>
    <Reference Include="SpreadsheetGear.Windows.Forms"><HintPath>$(StatsDirectBin)/SpreadsheetGear.Windows.Forms.dll</HintPath></Reference>
    <Content Include="$(StatsDirectBin)/**" Link="%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
