<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.17763.0</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <StatsDirectBin Condition="'$(StatsDirectBin)' == ''">../../StatsDirectUI/bin/Debug/net10.0-windows10.0.17763.0</StatsDirectBin>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="StatsDirect"><HintPath>$(StatsDirectBin)/StatsDirect.dll</HintPath></Reference>
    <None Include="references.tsv" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
