<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType><AssemblyName>StatsDirect.LearningChecks</AssemblyName>
    <TargetFramework>net10.0-windows10.0.17763.0</TargetFramework><UseWindowsForms>true</UseWindowsForms><ImplicitUsings>enable</ImplicitUsings>
    <StatsDirectBin Condition="'$(StatsDirectBin)' == ''">../../StatsDirectUI/bin/Release/net10.0-windows10.0.17763.0</StatsDirectBin>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../BrowserCopyProbe.cs" Link="BrowserCopyProbe.cs" />
    <Reference Include="StatsDirect"><HintPath>$(StatsDirectBin)/StatsDirect.dll</HintPath></Reference>
    <Reference Include="SpreadsheetGear"><HintPath>$(StatsDirectBin)/SpreadsheetGear.dll</HintPath></Reference>
    <Reference Include="SpreadsheetGear.Windows.Forms"><HintPath>$(StatsDirectBin)/SpreadsheetGear.Windows.Forms.dll</HintPath></Reference>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4258.31" />
    <PackageReference Include="ExcelDataReader" Version="3.9.0" />
    <PackageReference Include="RtfPipe" Version="2.0.7677.4303" />
    <Content Include="$(StatsDirectBin)/**" Exclude="$(StatsDirectBin)/TutorRuntime/**" Link="%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="mock-server.mjs" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="ai-pefr.R" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../../ReportEditor/upstream/Tests/Fixtures/Reports/*.rtf" Link="Fixtures/Reports/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
