<?xml version="1.0" encoding="utf-8"?>
<Include xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <!-- Desktop shortcuts - assumes surrounding Directory structure has been created. -->
  <Shortcut Id="StatsDirectExeDesktopShortcut"
            Directory="DesktopFolder"
            Name="StatsDirect"
            Description="StatsDirect Statistical Package"
            Icon="statsdirect.ico"
            WorkingDirectory="INSTALLLOCATION"
            Advertise="yes"/>
</Include>
