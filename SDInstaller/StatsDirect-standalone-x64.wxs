<!-- ON EACH BUILD, INCREMENT THE VERSION NUMBER IN STATSDIRECTUI - and remember this system ignores the fourth number! -->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
  xmlns:netfx="http://wixtoolset.org/schemas/v4/wxs/netfx"
  xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">

  <Package
    Name="StatsDirect"
    InstallerVersion="405"
    Language="1033"
    Manufacturer="StatsDirect Limited"
    Scope="perMachine"
    Version="!(bind.FileVersion.statsdirectexe)"
    UpgradeCode="CA3CA7A5-59DA-44a0-9716-15CFBAFDC77A">

    <!-- Packaging: a single .msi -->
    <Media Id="1" Cabinet="SD.cab" EmbedCab="yes" />
    <!-- Packaging: a .msi with separate compressed files in .cab format -->
    <!-- <Media Id="1" Cabinet="SD.cab" EmbedCab="no" /> -->

    <!-- Upgrading: we're willing to upgrade pretty much any version up to this one. -->
    <!-- For now, that's 3.x and 4.x - we're not blowing away 2.x installs.  That will change. -->
    <Property Id="PREVIOUSVERSIONSINSTALLED" Secure="yes" />
    <Property Id="NEWERVERSIONINSTALLED" Secure="yes" />
    <!-- SD3+, upgrade code CA3C.... -->
    <!-- The maximum is inclusive, so that another build with this same version number (a test build, or the unsigned build before the signed one) is removed
         first like any older version.  Otherwise the two are installed together, and Windows Installer keeps the existing StatsDirect.exe and StatsDirect.dll
         because their file version is not older than the new one's: the new build's program files never reach the disk.  ICE61 warns about this; it is intended.
         Windows Installer compares the first three fields only, so a build that differs in the fourth field counts as the same version and is replaced as well,
         whichever of the two is newer.  The setup bundle compares all four and refuses to replace a newer build. -->
    <Upgrade Id="CA3CA7A5-59DA-44a0-9716-15CFBAFDC77A">
      <UpgradeVersion OnlyDetect="no" Minimum="3.0.0.0" Maximum="!(bind.FileVersion.statsdirectexe)" Property="PREVIOUSVERSIONSINSTALLED" IncludeMinimum="yes" IncludeMaximum="yes" />
      <UpgradeVersion OnlyDetect="yes" Minimum="!(bind.FileVersion.statsdirectexe)" Maximum="99.99.9999.9999" Property="NEWERVERSIONDETECTED" IncludeMinimum="no" IncludeMaximum="yes" />
    </Upgrade>
    <InstallExecuteSequence>
      <RemoveExistingProducts Before="InstallInitialize"></RemoveExistingProducts>
    </InstallExecuteSequence>

    <!-- User interface and license -->
    <!-- Licence file location -->
    <WixVariable Id="WixUILicenseRtf" Value="Licence.rtf" />
    <!-- Tell the UI what property holds the install directory -->
    <Property Id="WIXUI_INSTALLDIR" Value="INSTALLLOCATION" />
    <!-- Custom bitmaps -->
    <WixVariable Id="WixUIBannerBmp" Value="bannrbmp-sd.bmp" />
    <WixVariable Id="WixUIDialogBmp" Value="dlgbmp-sd.bmp" />
    <UI>
      <!-- Add/Remove Programs values -->
      <Property Id="ARPCONTACT" Value="support@statsdirect.com" />
      <Property Id="ARPHELPLINK" Value="http://www.statsdirect.com/Support.aspx" />
      <Property Id="ARPURLINFOABOUT" Value="http://www.statsdirect.com/Specifications.aspx" />
      <Property Id="ARPURLUPDATEINFO" Value="http://www.statsdirect.com/Update.aspx" />
      <ProgressText Action="RollbackCleanup" Message="Removing backup files and starting StatsDirect optimisation" />
    </UI>
    <!-- Link in the common dialog - usually we'd use a UIRef to WixUI_InstallDir, but we're using Common and referencing the bits we need due to the extra UI referencing above. -->
    <ui:WixUI Id="WixUI_InstallDir" />

    <!-- Icon in add/remove programs -->
    <Icon Id="statsdirect.ico" SourceFile="..\StatsDirectUI\UI\Graphics\sd3.ico" />
    <Property Id="ARPPRODUCTICON" Value="statsdirect.ico" />

    <!-- Installation conditions: the .NET 10 Windows Desktop runtime. The setup bundle installs it before this package runs; this check matters only when the .msi is run on its own.
         RollForward is the program's own policy (the default, "minor": StatsDirect.runtimeconfig.json sets none), so that the check passes exactly when the program can start.
         With "major", a PC that has only a later major version passed the check and then could not start the program. -->
    <netfx:DotNetCompatibilityCheck
      Property="DOTNETDESKTOP10RUNTIMECHECK"
      RollForward="minor"
      RuntimeType="desktop"
      Platform="x64"
      Version="10.0.0"/>
    <Launch Condition="Installed OR DOTNETDESKTOP10RUNTIMECHECK=&quot;0&quot;" Message="[ProductName] requires the .NET 10 Desktop Runtime (x64). Install it from https://dotnet.microsoft.com/en-us/download/dotnet/10.0 and run this installer again, or use StatsDirectSetup.exe, which installs it for you." />
    <!-- Installation conditions: At least Windows 10, no upper limit on OS version-->
<!--
    <Launch Condition="Installed OR (VersionNT &gt;= 603)" Message="StatsDirect is not supported on this version of Windows. It is supported on Windows 10, 11 and Server 2016-2022." />
-->
    <!-- If we're attempting to install an older version over a newer one, warn the user and stop -->
    <Launch Condition="NOT NEWERVERSIONDETECTED OR Installed" Message="A later version of [ProductName] is already installed. If you wish to install this version, uninstall the later version then run this installer again. Setup will now exit." />

    <!-- Start menu shortcut -->
    <StandardDirectory Id="ProgramMenuFolder">
      <Component Id="ApplicationShortcut" Guid="4A69827f-392D-49aa-81DF-B660EA920F25">
        <Shortcut Id="ApplicationStartMenuShortcut" Name="StatsDirect" Description="StatsDirect Statistical Package" Icon="statsdirect.ico" Target="[INSTALLLOCATION]StatsDirect.exe" WorkingDirectory="INSTALLLOCATION" />
        <RemoveFolder Id="ApplicationProgramsFolder" On="uninstall" />
        <RegistryValue Root="HKCU" Key="Software\StatsDirect\StatsDirect" Name="startMenuInstalled" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </StandardDirectory>

    <!-- Main installation files -->
    <StandardDirectory Id="DesktopFolder" />
    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLLOCATION" Name="StatsDirect" FileSource="$(var.StatsDirectUI.TargetDir)">
        <Component Id="ProductComponent" Guid="CE038078-F78B-42b0-A547-8509996AA427">
          <File Id="statsdirectexe" KeyPath="yes" Name="StatsDirect.exe" Checksum="yes">
            <netfx:NativeImage Id="ngen_statsdirect.exe" Platform="64bit" Priority="0" AppBaseDirectory="INSTALLLOCATION" />
            <Shortcut Id="StatsDirectExeDesktopShortcut" Directory="DesktopFolder" Name="StatsDirect" Description="StatsDirect Statistical Package" Icon="statsdirect.ico" WorkingDirectory="INSTALLLOCATION" Advertise="yes" />
          </File>
        </Component>
        <Files Include="$(var.StatsDirectUI.TargetDir)\**">
          <Exclude Files="$(var.StatsDirectUI.TargetDir)\StatsDirect.exe" />
          <!-- Things that can be in the build output but do not belong on a user's machine: the result files that -sanity-check and -test-operations write beside the program, and any separate symbol files. -->
          <Exclude Files="$(var.StatsDirectUI.TargetDir)\sanity-check-results.txt" />
          <Exclude Files="$(var.StatsDirectUI.TargetDir)\test-operations-results.txt" />
          <Exclude Files="$(var.StatsDirectUI.TargetDir)\**\*.pdb" />
        </Files>
      </Directory>
    </StandardDirectory>
  </Package>
</Wix>
