<?xml version="1.0" encoding="utf-8"?>
<Include xmlns="http://schemas.microsoft.com/wix/2006/wi"
         xmlns:netfx="http://schemas.microsoft.com/wix/NetFxExtension">
  <!-- Upgrading: we're willing to upgrade pretty much any version up to this one. -->
  <!-- For now, that's 3.x only - we're not blowing away 2.x installs.  That will change. -->
  <Property Id="PREVIOUSVERSIONSINSTALLED" Secure="yes" />
  <Property Id="NEWERVERSIONINSTALLED" Secure="yes" />
  <!-- SD3, upgrade code CA3C.... -->
  <Upgrade Id="CA3CA7A5-59DA-44a0-9716-15CFBAFDC77A">
    <UpgradeVersion OnlyDetect="no" Minimum="3.0.0.0" Maximum="!(bind.FileVersion.statsdirectexe)" Property="PREVIOUSVERSIONSINSTALLED" IncludeMinimum="yes" IncludeMaximum="no" />
    <UpgradeVersion OnlyDetect="yes" Minimum="!(bind.FileVersion.statsdirectexe)" Maximum="99.99.9999.9999" Property="NEWERVERSIONDETECTED" IncludeMinimum="no" IncludeMaximum="yes" />
  </Upgrade>
  <InstallExecuteSequence>
    <RemoveExistingProducts Before="InstallInitialize"></RemoveExistingProducts>
  </InstallExecuteSequence>

  <!-- User interface and license -->
  <!-- Licence file location -->
  <WixVariable Id="WixUILicenseRtf" Value="Licence.rtf"/>
  <!-- Tell the UI what property holds the install directory -->
  <Property Id="WIXUI_INSTALLDIR" Value="INSTALLLOCATION" />
  <!-- Reference the property from netfx that tells us whether framework 4.6.2 is installed or not -->
  <PropertyRef Id="WIX_IS_NETFRAMEWORK_462_OR_LATER_INSTALLED"/>
  <!-- Custom bitmaps -->
  <WixVariable Id="WixUIBannerBmp" Value="bannrbmp-sd.bmp"/>
  <WixVariable Id="WixUIDialogBmp" Value="dlgbmp-sd.bmp"/>
  <UI>
    <!-- Add/Remove Programs values -->
    <Property Id='ARPCONTACT'>support@statsdirect.com</Property>
    <Property Id='ARPHELPLINK'>http://www.statsdirect.com/Support.aspx</Property>
    <Property Id='ARPURLINFOABOUT'>http://www.statsdirect.com/Specifications.aspx</Property>
    <Property Id='ARPURLUPDATEINFO'>http://www.statsdirect.com/Update.aspx</Property>
    <ProgressText Action="RollbackCleanup">Removing backup files and starting StatsDirect optimisation</ProgressText>
  </UI>
  <!-- Link in the common dialog - usually we'd use a UIRef to WixUI_InstallDir, but we're using Common and referencing the bits we need due to the extra UI referencing above. -->
  <UIRef Id="WixUI_InstallDir" />

  <!-- Icon in add/remove programs -->
  <Icon Id="statsdirect.ico" SourceFile="..\StatsDirectUI\UI\Graphics\sd3.ico"/>
  <Property Id="ARPPRODUCTICON" Value="statsdirect.ico" />

  <Condition Message="[ProductName] requires .NET Framework 4.6.2 or higher.">
    <![CDATA[Installed OR WIX_IS_NETFRAMEWORK_462_OR_LATER_INSTALLED]]>
  </Condition>
  <!-- Installation conditions: At least Windows 7, no service pack required, no upper limit on OS version-->
  <Condition Message="StatsDirect is not supported on this version of Windows. It is supported on Windows 7, 2012, 8, 8.1, 2012R2, 10, and 2016.">
    <![CDATA[Installed OR (VersionNT >= 601)]]>
  </Condition>
  <!-- If we're attempting to install an older version over a newer one, warn the user and stop -->
  <Condition Message="A later version of [ProductName] is already installed. If you wish to install this version, uninstall the later version then run this installer again. Setup will now exit.">
    NOT NEWERVERSIONDETECTED OR Installed
  </Condition>
</Include>
