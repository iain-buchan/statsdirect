<?xml version="1.0" encoding="utf-8"?>
<Include xmlns:netfx="http://schemas.microsoft.com/wix/NetFxExtension">
  <Feature Id="ProductFeature" Title="SDInstaller" Level="1">
    <!-- Shortcuts -->
    <ComponentRef Id="ApplicationShortcut" />
    <ComponentRef Id="CalculatorShortcut" />

    <!-- Main files -->
    <ComponentRef Id="ProductComponent" />

    <!-- Other StatsDirect -->
    <ComponentRef Id="menu.xml" />
    <ComponentRef Id="STATSDIRECT.chm" />
    <ComponentRef Id="StatsDirect.exe.config" />
    <ComponentGroupRef Id="Dlls" />

    <!-- Sample files -->
    <ComponentRef Id="test.xlsx" />

    <!-- Excel add-in -->
    <ComponentRef Id="StatsDirect3ExcelLink.xlam" />

    <!-- Operations -->
    <ComponentGroupRef Id="Operations" />

    <!-- Output templates -->
    <ComponentGroupRef Id="Template" />
  </Feature>
</Include>
