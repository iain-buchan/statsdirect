    <ComponentRef Id="DevExpress.Utils.v15.1.dll" />
    <ComponentRef Id="DevExpress.XtraBars.v15.1.dll" />
    <ComponentRef Id="DevExpress.XtraEditors.v15.1.dll" />
    <ComponentRef Id="DevExpress.XtraPrinting.v15.1.dll" />
