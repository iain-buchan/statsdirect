<?xml version="1.0" encoding="utf-8"?>
<Include xmlns:netfx="http://schemas.microsoft.com/wix/NetFxExtension">
  <Component Id="menu.xml">
    <File Id="menu.xml" KeyPath="yes" Name="menu.xml" Checksum="yes" />
  </Component>
  <Component Id="STATSDIRECT.chm">
    <File Id="STATSDIRECT.chm" KeyPath="yes" Name="STATSDIRECT.chm" Checksum="yes" />
  </Component>
  <Component Id="StatsDirect.exe.config">
    <File Id="StatsDirect.exe.config" KeyPath="yes" Name="StatsDirect.exe.config" Checksum="yes" />
  </Component>

  <!-- Sample data files -->
  <Directory Id="data" Name="data">
    <Component Id="test.xlsx">
      <File Id="test.xlsx" KeyPath="yes" Name="test.xlsx" Checksum="yes" ReadOnly="yes" />
    </Component>
  </Directory>

  <!-- Excel add-in -->
  <Directory Id="Excel" Name="Excel">
    <Component Id="StatsDirect3ExcelLink.xlam">
      <File Id="StatsDirect3ExcelLink.xlam" KeyPath="yes" Name="StatsDirect3ExcelLink.xlam" Checksum="yes" />
    </Component>
  </Directory>

  <!-- Operations -->
  <Directory Id="Operations" Name="Operations" />

  <!-- Output templates -->
  <Directory Id="Template" Name="Template" />
</Include>
