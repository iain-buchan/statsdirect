<Project>
  <Import Project="Sdk.props" Sdk="WixToolset.Sdk" Version="4.0.0" />
  <PropertyGroup>
    <Platform Condition=" '$(Platform)' == '' ">x64</Platform>
    <ProductVersion>3.0</ProductVersion>
    <OutputName>StatsDirect</OutputName>
    <RunPostBuildEvent>OnOutputUpdated</RunPostBuildEvent>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Debug|x64' ">
    <OutputPath>bin\$(Platform)\$(Configuration)\</OutputPath>
    <IntermediateOutputPath>obj\$(Platform)\$(Configuration)\</IntermediateOutputPath>
    <DefineConstants>Debug;OperationsSource=$(SolutionDir)StatsDirectUI\Assets\Operations;TemplateSource=$(SolutionDir)StatsDirectUI\Assets\Template;DllsSource=$(SolutionDir)StatsDirectUI\bin\AnyCPU\$(Configuration)</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Release|x64' ">
    <OutputPath>bin\$(Platform)\$(Configuration)\</OutputPath>
    <IntermediateOutputPath>obj\$(Platform)\$(Configuration)\</IntermediateOutputPath>
    <DefineConstants>OperationsSource=$(SolutionDir)StatsDirectUI\Assets\Operations;TemplateSource=$(SolutionDir)StatsDirectUI\Assets\Template;DllsSource=$(SolutionDir)StatsDirectUI\bin\AnyCPU\$(Configuration)</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'ReleaseWithSigning|x64' ">
    <OutputPath>bin\$(Platform)\$(Configuration)\</OutputPath>
    <IntermediateOutputPath>obj\$(Platform)\$(Configuration)\</IntermediateOutputPath>
    <DefineConstants>OperationsSource=$(SolutionDir)StatsDirectUI\Assets\Operations;TemplateSource=$(SolutionDir)StatsDirectUI\Assets\Template;DllsSource=$(SolutionDir)StatsDirectUI\bin\AnyCPU\$(Configuration)</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'ReleaseWithSigning|AnyCPU' ">
    <OutputPath>bin\$(Platform)\$(Configuration)\</OutputPath>
    <IntermediateOutputPath>obj\$(Platform)\$(Configuration)\</IntermediateOutputPath>
    <DefineConstants>OperationsSource=$(SolutionDir)StatsDirectUI\Assets\Operations;TemplateSource=$(SolutionDir)StatsDirectUI\Assets\Template;DllsSource=$(SolutionDir)StatsDirectUI\bin\AnyCPU\$(Configuration)</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'ReleaseWithSigning|Any CPU' ">
    <OutputPath>bin\$(Platform)\$(Configuration)\</OutputPath>
    <IntermediateOutputPath>obj\$(Platform)\$(Configuration)\</IntermediateOutputPath>
    <DefineConstants>OperationsSource=$(SolutionDir)StatsDirectUI\Assets\Operations;TemplateSource=$(SolutionDir)StatsDirectUI\Assets\Template;DllsSource=$(SolutionDir)StatsDirectUI\bin\AnyCPU\$(Configuration)</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\StatsDirectUI\StatsDirectUI.csproj">
      <Name>StatsDirectUI</Name>
      <Project>{c73e1b83-a745-4592-92a0-40c5658d6d7c}</Project>
      <Private>True</Private>
    </ProjectReference>
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="WixToolset.NetFx.wixext" Version="4.0.0" />
    <PackageReference Include="WixToolset.Util.wixext" Version="4.0.0" />
    <PackageReference Include="WixToolset.UI.wixext" Version="4.0.0" />
    <PackageReference Include="WixToolset.Heat" Version="4.0.0" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="bannrbmp-sd.bmp" />
    <Content Include="DllsOnly.xslt" />
    <Content Include="dlgbmp-sd.bmp" />
    <Content Include="Licence.rtf" />
  </ItemGroup>
  <Import Project="Sdk.targets" Sdk="WixToolset.Sdk" Version="4.0.0" />
  <PropertyGroup>
    <PostBuildEvent>if $(ConfigurationName) == ReleaseWithSigning copy "$(TargetPath)" "$(SolutionDir)ReleaseBuild"</PostBuildEvent>
  </PropertyGroup>
  <ItemGroup>
    <HarvestDirectory Include="$(SolutionDir)StatsDirectUI/Assets/Operations">
      <ComponentGroupName>Operations</ComponentGroupName>
      <DirectoryRefId>Operations</DirectoryRefId>
      <PreprocessorVariable>var.OperationsSource</PreprocessorVariable>
      <SuppressRootDirectory>true</SuppressRootDirectory>
    </HarvestDirectory>
    <HarvestDirectory Include="$(SolutionDir)StatsDirectUI/Assets/Template">
      <ComponentGroupName>Template</ComponentGroupName>
      <DirectoryRefId>Template</DirectoryRefId>
      <PreprocessorVariable>var.TemplateSource</PreprocessorVariable>
      <SuppressRootDirectory>true</SuppressRootDirectory>
    </HarvestDirectory>
    <HarvestDirectory Include="$(SolutionDir)StatsDirectUI/bin/AnyCPU/$(Configuration)">
      <ComponentGroupName>Dlls</ComponentGroupName>
      <DirectoryRefId>INSTALLLOCATION</DirectoryRefId>
      <SuppressCom>True</SuppressCom>
      <SuppressRegistry>True</SuppressRegistry>
      <SuppressRootDirectory>true</SuppressRootDirectory>
      <Transforms>DllsOnly.xslt</Transforms>
      <VerboseOutput>true</VerboseOutput>
      <Crud>true</Crud>
    </HarvestDirectory>
  </ItemGroup>
</Project>