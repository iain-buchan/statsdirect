<Project Sdk="WixToolset.Sdk/5.0.0">
  <PropertyGroup>
    <Platform>x64</Platform>
    <ProductVersion>4.0</ProductVersion>
    <OutputName>StatsDirect-x64</OutputName>
    <SignOutput>true</SignOutput>
  </PropertyGroup>
  <ItemGroup>
    <Content Include="bannrbmp-sd.bmp" />
    <Content Include="dlgbmp-sd.bmp" />
  </ItemGroup>
  <ItemGroup>
    <None Include="global.json" />
    <None Include="Licence.rtf" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\StatsDirectUI\StatsDirectUI.csproj">
      <Name>StatsDirectUI</Name>
      <Project>{c73e1b83-a745-4592-92a0-40c5658d6d7c}</Project>
      <Private>True</Private>
    </ProjectReference>
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="WixToolset.NetFx.wixext" Version="5.0.0" />
    <PackageReference Include="WixToolset.Util.wixext" Version="5.0.0" />
    <PackageReference Include="WixToolset.UI.wixext" Version="5.0.0" />
    <PackageReference Include="WixToolset.Heat" Version="5.0.0" />
  </ItemGroup>
  <Target Name="SignMsi">
    <Message Importance="high" Text="SignMsi: @(SignMsi)" />
    <Exec Command='..\Key\sign.cmd "%(SignMsi.FullPath)" ' />
  </Target>
</Project>
