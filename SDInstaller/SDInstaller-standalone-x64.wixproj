<Project Sdk="WixToolset.Sdk/6.0.2">
  <PropertyGroup>
    <Platform>x64</Platform>
    <ProductVersion>5.0</ProductVersion>
    <OutputName>StatsDirect-x64</OutputName>
    <OutputPath>..\ReleaseBuild</OutputPath>
    <Configurations>Debug;Release;ReleaseWithSigning</Configurations>
    <!-- Only ReleaseWithSigning signs: Release must build on a machine that has no signing key. StatsDirectUI.slnx passes the solution's Release and ReleaseWithSigning configurations straight through to this project. -->
    <SignOutput Condition="'$(Configuration)' == 'ReleaseWithSigning'">true</SignOutput>
  </PropertyGroup>
  <ItemGroup>
    <Content Include="bannrbmp-sd.bmp" />
    <Content Include="dlgbmp-sd.bmp" />
  </ItemGroup>
  <ItemGroup>
    <None Include="global.json" />
    <None Include="Licence.rtf" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\StatsDirectUI\StatsDirectUI.csproj">
      <Name>StatsDirectUI</Name>
      <Project>{c73e1b83-a745-4592-92a0-40c5658d6d7c}</Project>
      <Private>True</Private>
      <!-- StatsDirectUI has no ReleaseWithSigning build of its own: always package its optimised Release build, even when this project is built directly rather than through the solution. -->
      <SetConfiguration>Configuration=Release</SetConfiguration>
    </ProjectReference>
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="WixToolset.NetFx.wixext" Version="6.0.2" />
    <PackageReference Include="WixToolset.Util.wixext" Version="6.0.2" />
    <PackageReference Include="WixToolset.UI.wixext" Version="6.0.2" />
    <PackageReference Include="WixToolset.Heat" Version="6.0.2" />
  </ItemGroup>
  <!-- ReleaseWithSigning: sign StatsDirect.exe and StatsDirect.dll in StatsDirectUI's output before they are bound into the installer, so that the
       program itself carries the publisher's signature as well as the .msi and the setup bundle; and StatsDirectRetire.dll beside them, which the
       installer runs as the system account. Runs once the project references are resolved,
       which is when StatsDirectUI has been built, and before CoreCompile binds the files. WiX keeps the resolved outputs in _WixReferencedProjectOutputs. -->
  <Target Name="SignStatsDirectBinaries" AfterTargets="_ConvertResolvedProjectReferencesIntoWixConstructs" BeforeTargets="CoreCompile" Condition="'$(SignOutput)' == 'true'">
    <ItemGroup>
      <_StatsDirectOutputDir Include="@(_WixReferencedProjectOutputs->'%(RootDir)%(Directory)')" Condition="'%(Filename)' == 'StatsDirect'" />
      <_StatsDirectBinaryToSign Include="@(_StatsDirectOutputDir->'%(Identity)StatsDirect.exe');@(_StatsDirectOutputDir->'%(Identity)StatsDirect.dll');@(_StatsDirectOutputDir->'%(Identity)StatsDirectRetire.dll')" />
    </ItemGroup>
    <Error Condition="'@(_StatsDirectBinaryToSign)' == ''" Text="SignStatsDirectBinaries: the StatsDirectUI project reference was not resolved, so there is nothing to sign." />
    <Message Importance="high" Text="SignStatsDirectBinaries: @(_StatsDirectBinaryToSign)" />
    <Exec Command="..\Key\sign.cmd &quot;%(_StatsDirectBinaryToSign.FullPath)&quot;" Condition="Exists('%(_StatsDirectBinaryToSign.FullPath)')" />
  </Target>
  <Target Name="SignMsi">
    <Message Importance="high" Text="SignMsi: @(SignMsi)" />
    <Exec Command="..\Key\sign.cmd &quot;%(SignMsi.FullPath)&quot; " />
  </Target>
</Project>