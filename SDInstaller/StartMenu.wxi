<?xml version="1.0" encoding="utf-8"?>
<Include xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <!-- Start menu shortcuts -->
  <Directory Id="ProgramMenuFolder">
    <Component Id="ApplicationShortcut" Guid="4A69827f-392D-49aa-81DF-B660EA920F25">
      <Shortcut Id="ApplicationStartMenuShortcut"
                Name="StatsDirect"
                Description="StatsDirect Statistical Package"
                Icon="statsdirect.ico"
                Target="[INSTALLLOCATION]StatsDirect.exe"
                WorkingDirectory="INSTALLLOCATION"/>
      <RemoveFolder Id="ApplicationProgramsFolder" On="uninstall"/>
      <RegistryValue Root="HKCU" Key="Software\StatsDirect\StatsDirect" Name="startMenuInstalled" Type="integer" Value="1" KeyPath="yes"/>
    </Component>
  </Directory>
</Include>
