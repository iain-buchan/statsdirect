<?xml version="1.0" encoding="utf-8"?>
<Include xmlns="http://schemas.microsoft.com/wix/2006/wi" xmlns:netfx="http://schemas.microsoft.com/wix/NetFxExtension">
  <CustomAction Id="RunNgen" Property="NgenPath" ExeCommand="&quot;[NgenPath]&quot; install &quot;[#statsdirectexe]&quot;" Execute="commit" Impersonate="no" Return="ignore"/>
  <InstallExecuteSequence>
    <Custom Action="RunNgen" Before="InstallFinalize"></Custom>
  </InstallExecuteSequence>
</Include>
