<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net6.0-windows10.0.17763.0</TargetFramework>
    <OutputType>WinExe</OutputType>
    <AssemblyName>StatsDirect</AssemblyName>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>StatsDirect</RootNamespace>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <NoWarn>CA1416</NoWarn>
    <ApplicationDefaultFont>Microsoft Sans Serif, 8.25pt</ApplicationDefaultFont>
    <UseWPF>False</UseWPF>
    <StartupObject>StatsDirect.UI.Program</StartupObject>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="UI\frmReportDNBTest.cs" />
    <Compile Remove="UI\frmReportDNBTest.Designer.cs" />
    <Compile Remove="UI\frmReportDotNetBrowser.cs" />
    <Compile Remove="UI\frmReportDotNetBrowser.Designer.cs" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Remove="UI\frmReportDNBTest.resx" />
    <EmbeddedResource Remove="UI\frmReportDotNetBrowser.resx" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Antlr4" Version="4.6.6">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Antlr4.Runtime" Version="4.6.6" />
    <PackageReference Include="DevExpress.Win.RichEdit" Version="23.2.5" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.8.0" />
    <PackageReference Include="Microsoft.CodeAnalysis.VisualBasic" Version="4.8.0" />
    <PackageReference Include="MSTest.TestFramework" Version="3.1.1" />
    <PackageReference Include="OpenMcdf" Version="2.3.0" />
    <PackageReference Include="SpreadsheetGear.Windows" Version="9.2.26" />
  </ItemGroup>
  <ItemGroup>
    <ContentWithTargetPath Include="Assets/**">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <TargetPath>%(RecursiveDir)\%(Filename)%(Extension)</TargetPath>
    </ContentWithTargetPath>
  </ItemGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)' == 'Debug|AnyCPU'">
    <DefineConstants>$(DefineConstants);WATCH_EXCEPTIONS</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)' == 'Release|AnyCPU'">
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)' == 'ReleaseWithSigning|AnyCPU'">
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)' == 'DebugWatchExceptions|AnyCPU'">
  </PropertyGroup>
</Project>
