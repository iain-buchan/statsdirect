    <OutputPath>bin\$(Platform)\$(Configuration)\</OutputPath>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Debug|AnyCPU' ">
    <CodeAnalysisRuleSet>MinimumRecommendedRules.ruleset</CodeAnalysisRuleSet>
    <GenerateSerializationAssemblies>Auto</GenerateSerializationAssemblies>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Release|AnyCPU' ">
    <CodeAnalysisRuleSet>MinimumRecommendedRules.ruleset</CodeAnalysisRuleSet>
    <GenerateSerializationAssemblies>On</GenerateSerializationAssemblies>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'ReleaseWithSigning|AnyCPU' ">
    <DefineConstants>TRACE</DefineConstants>
    <Optimize>true</Optimize>
    <CodeAnalysisUseTypeNameInSuppression>true</CodeAnalysisUseTypeNameInSuppression>
    <CodeAnalysisModuleSuppressionsFile>GlobalSuppressions.cs</CodeAnalysisModuleSuppressionsFile>
    <CodeAnalysisRuleSet>MinimumRecommendedRules.ruleset</CodeAnalysisRuleSet>
    <GenerateSerializationAssemblies>On</GenerateSerializationAssemblies>
    <PostBuildEvent>
      "$(SolutionDir)Key\signtool\SignTool" sign /f "$(SolutionDir)Key\sdsign.pfx" /t http://timestamp.comodoca.com /p ***REMOVED*** "$(TargetPath)"
      "$(SolutionDir)Key\signtool\SignTool" sign /f "$(SolutionDir)Key\sd_sign_sha2.pfx" /fd sha256 /tr http://timestamp.comodoca.com /td sha256 /as /p ***REMOVED*** "$(TargetPath)"
      $(SolutionDir)Bin\sgen /n /f  /a:"$(TargetPath)"
      "$(SolutionDir)Key\signtool\SignTool" sign /f "$(SolutionDir)Key\sdsign.pfx" /t http://timestamp.comodoca.com /p ***REMOVED*** "$(TargetDir)$(TargetName).XmlSerializers.dll"
      "$(SolutionDir)Key\signtool\SignTool" sign /f "$(SolutionDir)Key\sd_sign_sha2.pfx" /fd sha256 /tr http://timestamp.comodoca.com /td sha256 /as /p ***REMOVED*** "$(TargetDir)$(TargetName).XmlSerializers.dll"
      xcopy /Q /Y /E $(ProjectDir)Assets\* $(TargetDir)
    </PostBuildEvent>
  </PropertyGroup>
  <PropertyGroup>
    <ApplicationManifest>Properties\app.manifest</ApplicationManifest>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)' == 'DebugWatchExceptions|AnyCPU'">
    <DebugSymbols>true</DebugSymbols>
    <DefineConstants>TRACE;DEBUG;WATCH_EXCEPTIONS</DefineConstants>
