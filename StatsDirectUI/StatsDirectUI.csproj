<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.17763.0</TargetFramework>
    <OutputType>WinExe</OutputType>
    <AssemblyName>StatsDirect</AssemblyName>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>StatsDirect</RootNamespace>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <NoWarn>CA1416</NoWarn>
    <ApplicationDefaultFont>Microsoft Sans Serif, 8.25pt</ApplicationDefaultFont>
    <UseWPF>False</UseWPF>
    <StartupObject>StatsDirect.UI.Program</StartupObject>
    <PublishReadyToRun>false</PublishReadyToRun>
    <TieredCompilation>false</TieredCompilation>
    <RunPostBuildEvent>OnBuildSuccess</RunPostBuildEvent>
    <Version>5.0.0</Version>
    <AssemblyTitle>StatsDirect</AssemblyTitle>
    <AssemblyDescription>StatsDirect statistical analysis workbench</AssemblyDescription>
    <Company>StatsDirect Limited</Company>
    <Product>StatsDirect</Product>
    <Copyright>Copyright ©1997-2026 StatsDirect Limited</Copyright>
    <!-- Take only the English resources of the packages we use. The other twelve languages of the compiler's messages added 15 MB to the installer and are never shown. -->
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <!-- Keep the line numbers in the stack traces that error messages show, without installing a separate .pdb: the symbols are embedded in StatsDirect.dll,
         and source paths are recorded relative to the repository rather than to the folders of whoever built it. -->
    <DebugType>embedded</DebugType>
    <PathMap>$(MSBuildProjectDirectory)=StatsDirectUI</PathMap>
  </PropertyGroup>
  <PropertyGroup>
	<!-- Pull the SSG license string from the environment - make sure you set this in your environment variables on your build machine! -->
    <SpreadsheetGearLicenseString>$(SPREADSHEETGEAR_LICENSE_STRING)</SpreadsheetGearLicenseString>
  </PropertyGroup>
  <ItemGroup>
    <AssemblyAttribute Include="StatsDirect.UI.SpreadsheetGearLicenseAttribute">
      <_Parameter1>$(SpreadsheetGearLicenseString)</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>
  <!-- Without a license string the build would succeed, but StatsDirect would then fail at startup with "Invalid signed license" - on this machine and for anyone who installs the result. Stop here instead. -->
  <Target Name="CheckSpreadsheetGearLicenseString" BeforeTargets="BeforeBuild" Condition="'$(AllowMissingSpreadsheetGearLicense)' != 'true'">
    <Error Condition="'$(SpreadsheetGearLicenseString)' == ''" Text="The SPREADSHEETGEAR_LICENSE_STRING environment variable is not set, so StatsDirect would be built without a SpreadsheetGear license and would not start. Set it as described in BUILDING.md, then restart Visual Studio or your terminal (environment variables are read at process start) and rebuild. To build without a license anyway, for example to run -sanity-check or -test-operations, pass -p:AllowMissingSpreadsheetGearLicense=true." />
  </Target>
  <ItemGroup>
    <AssemblyAttribute Include="System.CLSCompliantAttribute">
      <_Parameter1>false</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="UI\frmReportDNBTest.cs" />
    <Compile Remove="UI\frmReportDNBTest.Designer.cs" />
    <Compile Remove="UI\frmReportDotNetBrowser.cs" />
    <Compile Remove="UI\frmReportDotNetBrowser.Designer.cs" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Remove="UI\frmReportDNBTest.resx" />
    <EmbeddedResource Remove="UI\frmReportDotNetBrowser.resx" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Antlr4" Version="4.6.6">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Antlr4.Runtime" Version="4.6.6" />
    <PackageReference Include="DevExpress.Win.RichEdit" Version="26.1.4" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.9.0" />
    <PackageReference Include="Microsoft.CodeAnalysis.VisualBasic" Version="5.9.0" />
    <PackageReference Include="OpenMcdf" Version="3.3.0" />
    <PackageReference Include="PresentationFramework" Version="4.6.0" />
    <PackageReference Include="SpreadsheetGear" Version="9.3.84" />
    <PackageReference Include="SpreadsheetGear.Windows" Version="9.3.84" />
  </ItemGroup>
  <ItemGroup>
    <!-- Assets/WebHelp is a superseded copy of the web help that nothing in the program opens (Help uses STATSDIRECT.chm), and the mapping workbook is a
         note for whoever maintains the help; neither belongs on users' machines. -->
    <ContentWithTargetPath Include="Assets/**" Exclude="Assets/WebHelp/**;Assets/SD Help ID to File Name Mapping.xlsx">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <TargetPath>%(RecursiveDir)\%(Filename)%(Extension)</TargetPath>
    </ContentWithTargetPath>
  </ItemGroup>
  <ItemGroup>
    <Reference Include="PresentationFramework">
      <HintPath>..\..\..\..\..\Windows Kits\10\Windows Performance Toolkit\PresentationFramework.dll</HintPath>
    </Reference>
  </ItemGroup>
  <!-- The installer's helper (StatsDirectRetire: see OldSetupRetirer.cs there) is packaged from this project's output folder, beside StatsDirect.exe. Nothing in
       StatsDirect refers to it, so it is built first and its files are copied here rather than referenced. -->
  <ItemGroup>
    <ProjectReference Include="..\StatsDirectRetire\StatsDirectRetire.csproj" ReferenceOutputAssembly="false" OutputItemType="StatsDirectRetireAssembly" SetConfiguration="Configuration=Release" />
  </ItemGroup>
  <Target Name="CopyStatsDirectRetire" AfterTargets="CopyFilesToOutputDirectory">
    <ItemGroup>
      <_StatsDirectRetireFile Include="@(StatsDirectRetireAssembly->'%(RootDir)%(Directory)StatsDirectRetire.dll');@(StatsDirectRetireAssembly->'%(RootDir)%(Directory)StatsDirectRetire.runtimeconfig.json');@(StatsDirectRetireAssembly->'%(RootDir)%(Directory)StatsDirectRetire.deps.json')" />
    </ItemGroup>
    <Copy SourceFiles="@(_StatsDirectRetireFile)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" />
  </Target>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)' == 'Debug|AnyCPU'">
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)' == 'Release|AnyCPU'">
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)' == 'ReleaseWithSigning|AnyCPU'">
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)' == 'DebugWatchExceptions|AnyCPU'">
    <DefineConstants>$(DefineConstants);WATCH_EXCEPTIONS</DefineConstants>
  </PropertyGroup>
  <Target Name="PostBuild" AfterTargets="PostBuildEvent">
  </Target>
</Project>
