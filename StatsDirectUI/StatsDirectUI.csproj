<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net6.0-windows</TargetFramework>
    <OutputType>Exe</OutputType>
    <AssemblyName>StatsDirect</AssemblyName>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>StatsDirect</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="UI\frmReportDNBTest.cs" />
    <Compile Remove="UI\frmReportDNBTest.Designer.cs" />
    <Compile Remove="UI\frmReportDotNetBrowser.cs" />
    <Compile Remove="UI\frmReportDotNetBrowser.Designer.cs" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Remove="UI\frmReportDNBTest.resx" />
    <EmbeddedResource Remove="UI\frmReportDotNetBrowser.resx" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Antlr4" Version="4.6.6">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Antlr4.Runtime" Version="4.6.6" />
    <PackageReference Include="DevExpress.Win.RichEdit" Version="23.1.4" />
    <PackageReference Include="MSTest.TestFramework" Version="3.1.1" />
    <PackageReference Include="OpenMcdf" Version="2.3.0" />
    <PackageReference Include="SpreadsheetGear.Windows" Version="9.1.60-beta" />
  </ItemGroup>
  <ItemGroup>
    <ContentWithTargetPath Include="Assets/**">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <TargetPath>%(RecursiveDir)\%(Filename)%(Extension)</TargetPath>
    </ContentWithTargetPath>
  </ItemGroup>
</Project>
