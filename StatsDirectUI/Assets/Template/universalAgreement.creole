<report>
<title>Universal agreement (Berry-Mielke) R</title>
<br />
<table>
<tr><td>Measurement:</td><td><in>name</in></td></tr>
<tr><td>Number of measurements:</td><td><in>nobs</in></td></tr>
<tr><td>Number of observers:</td><td><in>b</in></td></tr>
<tr><td>Number of objects:</td><td><in>n</in></td></tr>
<tr><td>Number of dimensions:</td><td><in>c</in></td></tr>
<tr><td>Reference standard:</td><td><in>ref</in></td></tr>
</table>
<br />
<table>
<tr><td>Observed (realised) delta: </td><td><inu>delta</inu></td></tr>
<tr><td>Expected (mean) delta:</td><td><inu>edel</inu></td></tr>
<tr><td>Variance of delta:</td><td><inu>vardel</inu></td></tr>
<tr><td>Skewness of delta:</td><td><inu>skewdel</inu></td></tr>
</table>
<br />
<table>
<tr><td>Agreement coefficient R:</td><td><inu>R</inu></td></tr>
<tr><td><pval>Significance:</pval></td><td><pval><inp>p</inp></pval></td></tr>
</table>
</report>
