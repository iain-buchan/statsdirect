<report>
<line><title>Universal agreement (Berry-Mielke) R</title></line>
<line></line>
<table>
<tr><td>Measurement:</td><td><in>name</in></td></tr>
<tr><td>Number of measurements:</td><td><in>nobs</in></td></tr>
<tr><td>Number of observers:</td><td><in>b</in></td></tr>
<tr><td>Number of objects:</td><td><in>n</in></td></tr>
<tr><td>Number of dimensions:</td><td><in>c</in></td></tr>
<tr><td>Reference standard:</td><td><in>ref</in></td></tr>
</table>
<line></line>
<table>
<tr><td>Observed (realised) delta: </td><td><in>delta</in></td></tr>
<tr><td>Expected (mean) delta:</td><td><in>edel</in></td></tr>
<tr><td>Variance of delta:</td><td><in>vardel</in></td></tr>
<tr><td>Skewness of delta:</td><td><in>skewdel</in></td></tr>
</table>
<line></line>
<table>
<tr><td>Agreement coefficient R:</td><td><in>R</in></td></tr>
<tr><td><pval>Significance:</pval></td><td><pval><in>p</in></pval></td></tr>
</table>
</report>
