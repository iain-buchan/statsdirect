<report>
<line><title>Proportion meta-analysis</title></line>
<line></line>
<line>Method: <in>methodLabel</in></line>
<line></line>
<table>
<tr><th>Stratum</th><th>Responding</th><th>Total</th><th></th></tr>
<block name="inputs"><tr><td><in>st</in></td><td><in>r</in></td><td><in>n</in></td><td><subtotal><in>lb</in></subtotal></td></tr></block>
</table>
<line></line>
<table>
<tr><th>Stratum</th><th>Proportion</th><thfirst><ci><in>pc</in>% CI (exact)</ci></thfirst><thspan/><th></th></tr>
<block name="proportions"><tr><td><in>st</in></td><td><inu>p</inu></td><td><ci><inu>from_y</inu></ci></td><td><ci><inu>to_y</inu></ci></td><td><subtotal><in>lb</in></subtotal></td></tr></block>
</table>
<line></line>
<table>
<tr><th>Stratum</th><th>Standardized effect</th><th>Variance</th><thfirst>% Weights (fixed, random)</thfirst><thspan/><th></th></tr>
<block name="proportions"><tr><td><in>st</in></td><td><inu>yi</inu></td><td><inu>vi</inu></td><td><inu>wt</inu></td><td><inu>dwt</inu></td><td><subtotal><in>lb</in></subtotal></td></tr></block>
</table>
<line></line>
<line><u>Fixed effects (inverse variance)</u></line>
<line>Pooled proportion = <inu>rmh</inu> (<ci><in>pc</in>% CI = <inu>from</inu> to <inu>to</inu></ci>)</line>
<line></line>
<line><u>Non-combinability of studies</u></line>
<line>Cochran Q = <inu>qc</inu>  (df = <in>df</in>)  <pval><inp>xp</inp></pval></line>
<line>Moment-based estimate of between studies variance = <inu>tausq</inu></line>
<line>I<sub>2</sub> (inconsistency) = <in>isq</in>% (<ci><in>pc1</in>% CI = <in>llisq</in>% to <in>ulisq</in>%</ci>) </line>
<line></line>
<line><u>Random effects (DerSimonian-Laird)</u></line>
<line>Pooled proportion = <inu>dspr</inu> (<ci><in>pc</in>% CI = <inu>from_ds</inu> to <inu>to_ds</inu></ci>)</line>
<line></line>
<line><u>Bias indicators</u></line>
<block name="egger">
<line>Begg-Mazumdar: Kendall's <in>tau</in>  <pval><in>p2</in></pval></line>
<line>Egger: bias = <in>a</in> (<ci><in>pc_egger</in>% CI = <in>cl</in> to <in>cu</in></ci>)  <pval><in>p</in></pval></line>
</block>
<block name="harbord">
<line>Harbord: bias = <in>a</in> (<ci><in>pc_harbord</in>% CI = <in>cl</in> to <in>cu</in></ci>)  <pval><in>p</in></pval></line>
</block>
</report>
