<report>
<line><title>Fisher's exact test (expanded)</title></line>
<line></line>
<line><b>Input table:</b></line>
<table>
<tr><td><in>tab_a1</in></td><td><in>tab_b1</in></td></tr>
<tr><td><in>tab_a2</in></td><td><in>tab_b2</in></td></tr>
</table>
<line></line>
<line><b>Arranged table and totals:</b></line>
<table>
<tr><td><in>tab3_a1</in></td><td><in>tab3_b1</in></td><td><subtotal><in>tab3_c1</in></subtotal></td></tr>
<tr><td><in>tab3_a2</in></td><td><in>tab3_b2</in></td><td><subtotal><in>tab3_c2</in></subtotal></td></tr>
<tr><subtotal><td><in>tab3_a3</in></td><td><in>tab3_b3</in></td></subtotal><td><warn><in>tab3_c3</in></warn></td></tr>
</table>
<line></line>
<line>Expectation of A = <in>exp_a</in></line>
<line></line>
<table>
<block name="header">
<tr><td><warnabit>A</warnabit></td><td><warnabit>Lower Tail</warnabit></td><td><warnabit>Individual P</warnabit></td><td><warnabit>Upper Tail</warnabit></td></tr>
</block>
<block name="row">
<tr><td><warnabit><in>a</in></warnabit></td><td><warnabit><in>lower</in></warnabit></td><td><warnabit><in>ind_p</in></warnabit></td><td><warnabit><in>upper</in></warnabit></td></tr>
</block>
</table>
<line></line>
<line><pval>One sided <in>tail_1</in> P = <in>p_1</in>   (doubled: <in>p_1d</in>)</pval></line>
<line><pval>Two sided (by summation) P = <in>p_2</in></pval></line>
<line></line>
<line><pval>One sided mid-P = <in>mid_p</in></pval></line>
<line><pval>Two sided mid-P = <in>mid_p_2</in></pval></line>
</report>
