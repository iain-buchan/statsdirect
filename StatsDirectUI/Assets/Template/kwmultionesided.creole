<report>
  <title>Kruskal-Wallis: all pairwise comparisons (1-sided Conover-Inman)</title>
  <p>
    Critical t (@{df:round0} df, @{sided:roundu}-sided) = @{t:roundu}
  </p>

  <block name="conover">
    <table>
      <tr>
        <td>@t1 vs @t2</td>
        <td>
          <ci>@diff</ci>
        </td>
      </tr>
      <tr>
        <td>(@{meanrank1:roundu} @compmeanrank @{meanrank2:roundu})</td>
        <td>
          <pval>@{p:pval}</pval>
        </td>
      </tr>
    </table>
  </block>
</report>
