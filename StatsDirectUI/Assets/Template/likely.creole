<report>
<title>Likelihood ratios</title>
<table>
<tr><th>Result</th><th>+ Feature</th><th>- Feature</th><th>Likelihood Ratio</th><th><ci>@pc% CI (Koopman)</ci></th></tr>
<block name="row"><tr><td>@result</td><td>@+feature</td><td>@-feature</td><td>@{likely:roundu}</td><td><ci>@{from:roundu} to @{to:roundu}</ci></td></tr></block>
</table>
</report>
