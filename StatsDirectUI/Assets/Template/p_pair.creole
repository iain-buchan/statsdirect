<report>
<line><title>Paired proportions</title></line>
<line></line>
<line>Total = <in>n_out</in>,  both = <in>r_out</in>,  first only = <in>s_out</in>,  second only = <in>t_out</in></line>
<line>Proportion 1 = <inu>prop_1</inu></line>
<line>Proportion 2 = <inu>prop_2</inu></line>
<line>Proportion difference = <inu>prop_diff</inu></line>
<line></line>
<block name="exact">
<line><pval>Exact two sided <inp>cum_2</inp></pval></line>
<line><pval>Exact one sided <inp>cum_1</inp></pval></line>
<line></line>
<line><pval>Exact two sided mid <inp>cum_2_mid</inp></pval></line>
<line><pval>Exact one sided mid <inp>cum_1_mid</inp></pval></line>
</block>
<block name="approx">
<line><warn>Numbers too large for exact test</warn></line>
<line>Standard normal deviate z = <inu>z</inu></line>
<line>Approximate two sided <in>p_2</in></line>
<line>Approximate one sided <in>p_1</in></line>
</block>
<line></line>
<line><ci><in>qcl</in> <in>pc</in>% confidence interval for the proportion difference:</ci></line>
<line><ci><inu>lower</inu> to <inu>upper</inu></ci></line>
</report>
