<report>
<line><title>Paired proportions</title></line>
<line></line>
<line>Total = <in>n_out</in>,  both = <in>r_out</in>,  first only = <in>s_out</in>,  second only = <in>t_out</in></line>
<line>Proportion 1 = <in>prop_1</in></line>
<line>Proportion 2 = <in>prop_2</in></line>
<line>Proportion difference = <in>prop_diff</in></line>
<line></line>
<block name="exact">
<line><pval>Exact two sided <in>cum_2</in></pval></line>
<line><pval>Exact one sided <in>cum_1</in></pval></line>
<line></line>
<line><pval>Exact two sided mid <in>cum_2_mid</in></pval></line>
<line><pval>Exact one sided mid <in>cum_1_mid</in></pval></line>
</block>
<block name="approx">
<line><warn>Numbers too large for exact test</warn></line>
<line>Standard normal deviate z = <in>z</in></line>
<line>Approximate two sided <in>p_2</in></line>
<line>Approximate one sided <in>p_1</in></line>
</block>
<line></line>
<line><ci><in>qcl</in> <in>pc</in>% confidence interval for the proportion difference:</ci></line>
<line><ci><in>lower</in> to <in>upper</in></ci></line>
</report>
