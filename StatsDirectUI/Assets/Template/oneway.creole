<report>
<line><title>One way analysis of variance</title></line>
<line></line>
<line>Variables: <in>tlist</in></line>
<line></line>
<table>
<tr><th>Source of Variation</th><th>Sum Squares</th><th>DF</th><th>Mean Square</th></tr>
<tr><td>Between Groups</td><td><inu>b_sum</inu></td><td><in>b_df</in></td><td><inu>b_mean</inu></td></tr>
<tr><td>Within Groups</td><td><inu>w_sum</inu></td><td><in>w_df</in></td><td><inu>w_mean</inu></td></tr>
<tr><td>Corrected Total</td><td><inu>t_sum</inu></td><td><in>t_df</in></td><td></td></tr>
</table>
<line></line>
<line>F (variance ratio) = <inu>f</inu>  <pval><inp>p</inp></pval></line>
</report>
