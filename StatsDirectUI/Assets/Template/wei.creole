<report>
<line><title>Wei-Lachin analysis</title></line>
<block name="outer">
<line></line>
<line><title><in>title</in></title></line>
<line></line>
<line>total cases = <in>tot</in> (by group = <in>grp_1</in> and <in>grp_2</in>)</line>
<block name="repeats">
<line></line>
<line><u>Repeat time <in>time</in></u></line>
<table>
<tr><td>observed failures by group =</td><td><in>fail_1</in> and <in>fail_2</in></td></tr>
<tr><td>Wei-Lachin t =</td><td><in>t</in></td></tr>
<tr><td>Wei-Lachin variance =</td><td><in>var</in></td></tr>
<tr><td>chi-square =</td><td><in>chi</in></td><td><pval><inp>p</inp></pval></td></tr>
</table>
</block>
<line></line>
<line><title><in>title_multi</in></title></line>
<line></line>
<line><u>Covariance matrix</u>:</line>
<block name="covar"><line><in>mat</in></line></block>
<line></line>
<line><u>Inverse of covariance matrix</u>:</line>
<block name="inv_covar"><line><in>mat</in></line></block>
<line></line>
<line>repeat times = <in>rep</in></line>
<line>chi-square omnibus statistic = <in>stat</in>  <pval><inp>p_omnibus</inp></pval></line>
<line></line>
<line>stochastic ordering z = <in>z</in>  <pval>one sided <inp>p_1</inp>,  two sided <inp>p_2</inp></pval></line>
</block>
</report>
