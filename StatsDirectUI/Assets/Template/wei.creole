<report>
<title>Wei-Lachin analysis</title>
<block name="outer">
<br />
<title><in>title</in></title>

<p>total cases = <in>tot</in> (by group = <in>grp_1</in> and <in>grp_2</in>)</p>
<block name="repeats">

<p><u>Repeat time <in>time</in></u></p>
<table>
<tr><td>observed failures by group =</td><td><in>fail_1</in> and <in>fail_2</in></td></tr>
<tr><td>Wei-Lachin t =</td><td><in>t</in></td></tr>
<tr><td>Wei-Lachin variance =</td><td><in>var</in></td></tr>
<tr><td>chi-square =</td><td><in>chi</in></td><td><pval><inp>p</inp></pval></td></tr>
</table>
</block>
<br />
<title><in>title_multi</in></title>

<p><u>Covariance matrix</u>:</p>
<block name="covar"><p><in>mat</in></p></block>

<p><u>Inverse of covariance matrix</u>:</p>
<block name="inv_covar"><p><in>mat</in></p></block>

<p>repeat times = <in>rep</in><br />
chi-square omnibus statistic = <in>stat</in>  <pval><inp>p_omnibus</inp></pval></p>

<p>stochastic ordering z = <in>z</in>  <pval>one sided <inp>p_1</inp>,  two sided <inp>p_2</inp></pval></p>
</block>
</report>
