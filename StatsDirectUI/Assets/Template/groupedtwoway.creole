<report>
<block name="a">
<title>Two way randomized block analysis of variance for <in>variableName</in></title>
<line></line>
<line>Treatments: <in>tlist</in></line>
<line></line>
<table>
<tr><th>Source of Variation</th><th>Sum Squares</th><th>DF</th><th>Mean Square</th></tr>
<tr><td>Between blocks (rows)</td><td><in>sub_sum</in></td><td><in>sub_df</in></td><td><in>sub_mean</in></td></tr>
<tr><td>Between treatments (columns)</td><td><in>grp_sum</in></td><td><in>grp_df</in></td><td><in>grp_mean</in></td></tr>
<tr><td>Residual (error)</td><td><in>res_sum</in></td><td><in>res_df</in></td><td><in>res_mean</in></td></tr>
<tr><td>Corrected total</td><td><in>tot_sum</in></td><td><in>tot_df</in></td></tr>
</table>
<line></line>
<line>F (VR between blocks) = <in>sub_vr</in>  <pval><inp>sub_p</inp></pval></line>
<line></line>
<line>F (VR between treatments) = <in>grp_vr</in>  <pval><inp>grp_p</inp></pval></line>
<line></line>
<line></line>
</block>
</report>
