<table>
<tr><th>Source of variation</th><th>Sum Squares</th><th>DF</th><th>Mean Square</u></td></tr>
<tr><td>Regression</td><td><in>reg_sum</in></td><td><in>reg_df</in></td><td><in>reg_mean</in></td></tr>
<tr><td><subtotal>Residual</td><td><in>res_sum</in></td><td><in>res_df</in></td><td><in>res_mean</in></subtotal></td></tr>
