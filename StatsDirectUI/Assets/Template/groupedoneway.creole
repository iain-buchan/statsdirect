<report>
<block name="a">
<title>One way analysis of variance for @variableName</title>

<p>Variables: @tlist</p>

<table>
<tr><th>Source of Variation</th><th>Sum Squares</th><th>DF</th><th>Mean Square</th></tr>
<tr><td>Between Groups</td><td>@b_sum</td><td>@b_df</td><td>@b_mean</td></tr>
<tr><td>Within Groups</td><td>@w_sum</td><td>@w_df</td><td>@w_mean</td></tr>
<tr><td>Corrected Total</td><td>@t_sum</td><td>@t_df</td></tr>
</table>

<p>F (variance ratio) = @f  <pval>@p</pval></p>

<br />
</block>
</report>
