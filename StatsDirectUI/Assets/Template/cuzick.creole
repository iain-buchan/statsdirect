<report>
<line><title>Cuzick's trend test</title></line>
<line></line>
<line>Groups = <in>groups</in></line>
<line>Observations = <in>obs</in></line>
<line>Order: <in>order</in></line>
<line></line>
<table>
<tr><td>Ez =  <inu>ez</inu></td><td>Var(z) = <inu>varz</inu></td></tr>
<tr><td>T = <inu>t</inu></td><td>ET = <inu>et</inu></td><td>Var(T) = <inu>vart</inu></td></tr>
<tr><td>z = <inu>z</inu></td></tr>
</table>
<line></line>
<line><pval>One sided <inp>p_1</inp></pval></line>
<line><pval>Two sided <inp>p_2</inp></pval></line>
<block name="ties">
<line></line>
<line>Corrected for ties:</line>
<line>VarT = <inu>varttie</inu></line>
<line>z   = <inu>ztie</inu></line>
<line></line>
<line><pval>One sided <inp>p_1tie</inp></pval></line>
<line><pval>Two sided <inp>p_2tie</inp></pval></line>
</block>
</report>
