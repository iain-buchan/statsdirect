<report>
<line><title>Cuzick's trend test</title></line>
<line></line>
<line>Groups = <in>groups</in></line>
<line>Observations = <in>obs</in></line>
<line>Order: <in>order</in></line>
<line></line>
<table>
<tr><td>Ez =  <in>ez</in></td><td>Var(z) = <in>varz</in></td></tr>
<tr><td>T = <in>t</in></td><td>ET = <in>et</in></td><td>Var(T) = <in>vart</in></td></tr>
<tr><td>z = <in>z</in></td></tr>
</table>
<line></line>
<line><pval>One sided <in>p_1</in></pval></line>
<line><pval>Two sided <in>p_2</in></pval></line>
<line></line>
<line><block name="ties">Corrected for ties:</line>
<line>VarT = <in>varttie</in></line>
<line>z   = <in>ztie</in></line>
<line></line>
<line><pval>One sided <in>p_1tie</in></pval></line>
<line><pval>Two sided <in>p_2tie</in></block></pval></line>
</report>
