<report>
<title>Multiple linear regression - collinearity and parameter detail</title>
<table>
<tr><th></th><th>Coefficient</th><th>Standard Error</th><th><ci>@pc% Confidence Interval</ci></th></tr>
<block name="v"><tr><td>@label</td><td>@coef</td><td>@err</td><td><ci>@from  to  @to</ci></td></tr></block>
</table>

<table>
<tr><th></th><th>Variance Inflation Factor (VIF)</th><th></th><th>Tolerance (1/VIF)</th></tr>
<block name="vif"><tr><td>@label</td><td>@vif</td><td><warn>@x</warn></td><td>@rvif</td></tr></block>
</table>

<table>
<tr><td>mean VIF</td><td>@meanv</td></tr>
</table>
</report>
