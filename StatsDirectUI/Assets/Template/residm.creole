<report>
<title>Multiple linear regression - influential data</title>
<table>
<tr><th>Index</th><th>Y</th><th>Fitted Y</th><th>Std. Dev. Y fit</th><th>Residual</th></tr>
<block name="yfit"><tr><td>@index</td><td>@y</td><td>@fit_y</td><td>@std_err</td><td>@res</td></tr></block>
</table>

<table>
<tr><th colspan="2">Index</th><th colspan="2">Studentized</th><th colspan="2">Leverage</th><th>Cook's Distance</th></tr>
<block name="studentised"><tr><td>@index</td><td><b>@index_star</b></td><td>@stu</td><td><b>@stu_star</b></td><td>@hi</td><td><b>@hi_star</b></td><td>@cook</td></tr></block>
</table>

<table>
<tr><th colspan="2">Index</th><th colspan="2">Jackknife</th><th>DFIT</th></tr>
<block name="jackknife"><tr><td>@index</td><td><b>@index_star</b></td><td>@jack</td><td><warn>@jack_star</warn></td><td>@dfit</td></tr></block>
</table>

<p><u>Critical levels for unusual observations (marked *)</u><br />
Leverage > @zhi  [min(3p/n,.99)]<br />
Cook's Distance > @zcook  [f(a,p,n-p)]<br />
Studentized residual > &#xb1; @zstu  [t(a,n-p)]<br />
Jackknife residual > &#xb1; @zjack  [t(a,n-p-1)]<br />
DFIT > &#xb1; @zdfit  [(2*sqr(p/n)]</p>
</report>
