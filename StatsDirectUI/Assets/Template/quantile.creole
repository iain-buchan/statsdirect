<report>
<title>Quantile confidence interval</title>
<block name="variable">

<p>Variable: @sample<br />
Sample size = @size<br />
Quantile (@quantile_name) = @{value:roundu}<br />
<ci>Approximate @pc% CI @type = @from to @to</ci><br />
Exact confidence level = @exact</p>
</block>
</report>
