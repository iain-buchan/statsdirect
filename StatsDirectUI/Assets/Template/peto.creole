<report>
<title>Peto odds ratio meta-analysis</title>
<line></line>
<table>
<tr><th>Stratum</th><thfirst>Table (exposed +ve, control +ve, exposed -ve, control -ve)</thfirst><thspan/><thspan/><thspan/><th></th></tr>
<block name="inputs"><tr><td><in>st</in></td><td><in>a</in></td><td><in>b</in></td><td><in>c</in></td><td><in>d</in></td><td><in>lb</in></td></tr></block>
</table>
<line></line>
<table>
<tr><th>Stratum</th><th>O-E</th><th>Odds ratio</th><thfirst><ci><in>pc</in>% CI</ci></thfirst><thspan/><th></th></tr>
<block name="odds"><tr><td><in>st</in></td><td><inu>oe</inu></td><td><inu>or</inu></td><td><ci><inu>lci</inu></ci></td><td><ci><inu>uci</inu></ci></td><td><in>lb</in></td></tr></block>
</table>
<line></line>
<table>
<tr><th>Stratum</th><th>Standardized effect</th><th>Variance</th><th>% Weights</th><th></th></tr>
<block name="odds"><tr><td><in>st</in></td><td><inu>yi</inu></td><td><inu>vi</inu></td><td><inu>wt</inu> </td><td><in>lb</in></td></tr></block>
</table>
<line></line>
<table>
<tr><th>Stratum</th><th>V</th><th>z</th><th><pval>P(two sided)</pval></th><th></th></tr>
<block name="z"><tr><td><in>st</in></td><td><inu>v</inu></td><td><inu>z</inu></td><td><pval><inp>p</inp></pval></td><td><in>lb</in></td></tr></block>
</table>
<line></line>
<line>Pooled odds ratio = <inu>por</inu> (<ci><in>pc</in>% CI = <inu>from</inu> to <inu>to</inu></ci>)</line>
<line>Z (test of odds ratio differs from 1) = <inu>z</inu>  <pval><inp>p_z</inp></pval></line>
<line></line>
<line><u>Non-combinability of studies</u></line>
<line>Cochran Q = <inu>qc</inu>  (df = <in>df</in>)  <pval><inp>xp</inp></pval></line>
<line>I<sub>2</sub> (inconsistency) = <in>isq</in>% (<ci><in>pc1</in>% CI = <in>llisq</in>% to <in>ulisq</in>%</ci>) </line>
<line></line>
<line><u>Bias indicators</u></line>
<block name="egger">
<line>Begg-Mazumdar: Kendall's <in>tau</in>  <pval><inp>p2</inp></pval></line>
<line>Egger: bias = <in>a</in> (<ci><in>pc_egger</in>% CI = <in>cl</in> to <in>cu</in></ci>)  <pval><inp>p</inp></pval></line>
</block>
<block name="harbord">
<line>Harbord-Egger: bias = <in>a</in> (<ci><in>pc_harbord</in>% CI = <in>cl</in> to <in>cu</in></ci>)  <pval><inp>p</inp></pval></line>
</block>
</report>
