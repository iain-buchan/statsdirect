<report>
<title>Single sample t test</title>

<p>Sample name: <in>name</in><br />
Sample mean = <inu>sam_mean</inu><br />
Population mean = <inu>pop_mean</inu><br />
Sample size n = <in>size</in><br />
Sample sd = <inu>sd</inu></p>

<p><ci><in>pc</in>% confidence interval <in>for</in> = <inu>from</inu> to <inu>to</inu></ci></p>

<p>df = <in>df</in><br />
t  = <inu>t</inu></p>

<p><pval>One sided <inp>p_1</inp></pval><br />
<pval>Two sided <inp>p_2</inp></pval></p>

<p>Power <in>pwr</in></p>
</report>
