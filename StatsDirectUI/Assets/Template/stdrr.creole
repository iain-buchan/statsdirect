</table>
<line></line>
<table>
<tr><th>Stratum</th><th>Rate ratio</th><thfirst><ci><in>pc</in>% CI (<in>method</in>)</ci></thfirst><thspan/><th>Weight</th><th></th></tr>
<block name="rates"><tr><td><in>st</in></td><td><inu>rr</inu></td><td><ci><inu>lci</inu></ci></td><td><ci><inu>uci</inu></ci></td><td><inu>wt</inu></td><td><in>lb</in></td></tr></block>
