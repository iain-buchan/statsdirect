</table>
<line></line>
<table>
<tr><th>Stratum</th><th>Rate ratio</th><thfirst><ci><in>pc</in>% CI (<in>method</in>)</ci></thfirst><thspan/><th>Weight</th><th></th></tr>
<block name="rates"><tr><td><in>st</in></td><td><in>rr</in></td><td><ci><in>lci</in></ci></td><td><ci><in>uci</in></ci></td><td><in>wt</in></td><td><in>lb</in></td></tr></block>
