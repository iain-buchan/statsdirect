<report>
<title>Normality</title>
<block name="variable">

<table>
<tr><td>Sample name</td><td>@sample</td></tr>
<tr><td>Sample size</td><td>@n</td></tr>
<tr><td>Mean</td><td>@mean</td></tr>
<tr><td>Standard deviation</td><td>@sd</td></tr>
</table>

<table>
<tr><td>Skewness</td><td>@skewness  <pval>@{b1_p:pval}</pval></td></tr>
<tr><td>Kurtosis</td><td>@kurtosis  <pval>@{b2_p:pval}</pval></td></tr>
<tr><td>Royston chi-sq</td><td>@k2  <pval>@{k2_p:pval}</pval></td></tr>
</table>

<table>
<tr><td>Shapiro-Wilk W</td><td>@sw_w  @sw_v  <pval>@{sw_p:pval}</pval></td></tr>
<tr><td>Shapiro-Francia W'</td><td>@sf_w  @sf_v  <pval>@{sf_p:pval}</pval></td></tr>
</table>

<p>@result</p>


<p>@{chart:chart}</p>

</block>
</report>
