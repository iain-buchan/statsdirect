<report>
<line><title>Summary meta-analysis</title></line>
<line></line>
<table>
<tr><th>Study</th><th><in>stat</in><ci></th><th></ci>SE<ci></th><th>Approximate <in>pc</in>% CI</ci></u><block name="studies"></td></tr>
<tr><td><in>st</in></td><td><in>y</in></td><td><in>se</in></td><td><ci><in>from</in></td><td><in>to</in></td><td></ci><subtotal><in>lb</in></subtotal></block></td></tr>
</table>
<line></line>
<table>
<tr><th>Stratum</th><th>Standardized Effect</th><th>Standard Error</th><th>% Weights (fixed, random)</u><block name="studies"></td></tr>
<tr><td><in>st</in></td><td><in>standardized_effect</in></td><td><in>se</in></td><td><in>wt</in></td><td><in>dwt</in></td><td><subtotal><in>lb</in></subtotal></block></td></tr>
</table>
<line></line>
<line><u>Fixed effects (inverse variance)</u></line>
<line>Pooled <in>stat_fixed</in> = <in>rmh</in> (<ci><in>pc</in>% CI = <in>from_fixed</in> to <in>to_fixed</in></ci>)</line>
<line>Z (test <in>task</in>) = <in>z</in>  <pval><in>p_fixed</in></pval></line>
<line></line>
<line><u>Non-combinability of studies</u></line>
<line>Cochran Q = <in>qc</in>  (df = <in>df</in>) <warnabit> </warnabit><pval><in>xp</in></pval></line>
<line>Moment-based estimate of between studies variance = <in>tausq</in></line>
<line>I&#xb2; (inconsistency) = <in>isq</in>% (<ci><in>pc1</in>% CI = <in>llisq</in>% to <in>ulisq</in>%</ci>) </line>
<line></line>
<line><u>Random effects (DerSimonian-Laird)</u></line>
<line>Pooled <in>dsstat</in> = <in>dsrr</in> (<ci><in>pc</in>% CI = <in>dsll</in> to <in>dsul</in></ci>)</line>
<line>Z (test <in>stat</in>) = <in>dz</in>  <pval><in>dp</in></pval></line>
<line></line>
<line><u>Bias indicators</u><block name="bias"></line>
<line>Begg-Mazumdar: Kendall's <in>tau</in>  <pval><in>p2</in></pval></line>
<line>Egger: bias = <in>a</in> (<ci><in>pc</in>% CI = <in>cl</in> to <in>cu</in></ci>)  <pval><in>p</in></block></pval></line>
<line></line>
<line></line>
</report>
