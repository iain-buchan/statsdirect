<?xml version="1.0" encoding="utf-8"?>
<operation xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns="http://www.statsdirect.com/schemas/Operation.xsd">
	<name>Scheffe</name>
	<friendly-name lang="en-GB">Multiple comparison (Scheff&#233;)</friendly-name>
  <prerequisite-operation>OneWay</prerequisite-operation>
  <prerequisite-operation>ReplicateTwoWay</prerequisite-operation>
  <prerequisite-operation>TwoWay</prerequisite-operation>
  <steps>
    <settings>
      <parameters>
        <frame>
          <name>data</name>
          <prompt>Select DATA</prompt>
          <same-length>false</same-length>
          <mode>NumericReplaceMissing</mode>
          <min-columns>2</min-columns>
          <max-columns>200</max-columns>
          <ask-for-group-id>true</ask-for-group-id>
        </frame>
        <confidence-interval>
          <name>gamma</name>
        </confidence-interval>
      </parameters>
    </settings>
		<builtin function-name="rptScheffe" />
		<report type="text/rtf" filename="scheffe.rtf" />
	</steps>
</operation>
