<?xml version="1.0" encoding="utf-8"?>
<operation xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns="http://www.statsdirect.com/schemas/Operation.xsd">
	<name>InterpolateXY</name>
	<friendly-name lang="en-GB">Interpolate X to Y</friendly-name>
  <prerequisite-operation>SimpleLinearRegression</prerequisite-operation>
  <steps>
    <settings>
      <parameters>
        <confidence-interval>
          <name>gamma</name>
        </confidence-interval>
        <double>
          <name>newx</name>
          <prompt>New X value</prompt>
          <must-request>true</must-request>
        </double>
      </parameters>
    </settings>
		<builtin function-name="rptInterpolateXY" />
		<report type="text/rtf" filename="interp.rtf" />
	</steps>
</operation>
