<?xml version="1.0" encoding="utf-8"?>
<operation xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns="http://www.statsdirect.com/schemas/Operation.xsd">
	<name>LogisticRegressionPrediction</name>
	<friendly-name lang="en-GB">Prediction</friendly-name>
  <prerequisite-operation>LogisticRegression</prerequisite-operation>
  <steps>
    <settings>
      <parameters>
        <edit-grid>
          <name>candidatePredictors</name>
          <key-variable>Name</key-variable>
          <value-variable>Value</value-variable>
          <source>candidatePredictors</source>
          <must-request>true</must-request>
        </edit-grid>
        <confidence-interval>
          <name>gamma</name>
        </confidence-interval>
      </parameters>
    </settings>
		<builtin function-name="rptLogisticRegressionPrediction" />
    <report type="application/x-statsdirect-creole">
      <![CDATA[<report>
<line><title>Logistic regression - prediction</title></line>
<line></line>
<block name="predictors"><line><in>x</in></line></block>
<line></line>
<line><in>y</in></line>
<line></line>
<line><ci><in>pc</in>% Confidence interval = <in>from</in> to <in>to</in></ci></line>
</report>]]>
    </report>
  </steps>
</operation>
