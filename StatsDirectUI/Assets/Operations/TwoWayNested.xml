  <steps>
    <settings>
      <parameters>
        <frame2d>
          <name>data2d</name>
          <prompt></prompt>
          <sub-prompt>Select SUB-GROUP IDENTIFIER</sub-prompt>
          <same-length>true</same-length>
          <mode>Mode1</mode>
