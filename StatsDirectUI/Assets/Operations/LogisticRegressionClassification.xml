<?xml version="1.0" encoding="utf-8"?>
<operation xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns="http://www.statsdirect.com/schemas/Operation.xsd">
	<name>LogisticRegressionClassification</name>
	<friendly-name lang="en-GB">Classification</friendly-name>
  <prerequisite-operation>LogisticRegression</prerequisite-operation>
  <steps>
      <parameters>
        <double>
          <name>cutoff</name>
          <prompt>Rounding cut off</prompt>
          <must-request>true</must-request>
          <default-value>0.5</default-value>
          <minimum-value>0</minimum-value>
          <maximum-value>1</maximum-value>
        </double>
        <confidence-interval>
          <name>gamma</name>
        </confidence-interval>
      </parameters>
		<builtin function-name="rptLogisticRegressionClassification" />
    <report type="application/x-statsdirect-creole">
      <![CDATA[<report>
<title>Logistic regression - classification</title>
<table>
<tr><td></td><th colspan="3">Observed</th></tr>
<tr><td></td><td></td><th>Event</th><th>No Event</th><th>Total</th></tr>
<tr><td></td><th>Event</th><td>@tp</td><td>@fp</td><td>@totc</td></tr>
<tr><th>Classified</th><th>No Event</th><td>@fn</td><td>@tn</td><td>@totnoc</td></tr>
<tr><td></td><th>Total</th><td>@tote</td><td>@totnoe</td><td></td></tr>
</table>

<p>cutoff = @co</p>

<p>sensitivity = @sens%<br />
specificity = @spec%</p>

<p>+ve predictive value = @+ve%<br />
-ve predictive value = @npv%<br />
predictive value despite -ve test = @-ve%</p>

<p>correctly classified = @cc%</p>

<p>likelihood ratio (@pc% CI):<br />
LR (+ve) = @lr+ (@from+ to @to+)<br />
LR (-ve) = @lr- (@from- to @to-)</p>

<p> 'near' cut-off at max(sens+spec) = @cmax</p>

<p> area under ROC curve = @area</p>

<p>@{chart:chart}</p>
</report>]]>
    </report>
	</steps>
</operation>
