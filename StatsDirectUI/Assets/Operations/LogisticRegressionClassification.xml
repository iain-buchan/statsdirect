<?xml version="1.0" encoding="utf-8"?>
<operation xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns="http://www.statsdirect.com/schemas/Operation.xsd">
	<name>LogisticRegressionClassification</name>
	<friendly-name lang="en-GB">Classification</friendly-name>
  <prerequisite-operation>LogisticRegression</prerequisite-operation>
  <steps>
      <parameters>
        <double>
          <name>cutoff</name>
          <prompt>Rounding cut off</prompt>
          <must-request>true</must-request>
          <default-value>0.5</default-value>
          <minimum-value>0</minimum-value>
          <maximum-value>1</maximum-value>
        </double>
        <confidence-interval>
          <name>gamma</name>
        </confidence-interval>
      </parameters>
		<builtin function-name="rptLogisticRegressionClassification" />
    <report type="application/x-statsdirect-creole">
      <![CDATA[<report>
<title>Logistic regression - classification</title>
<br />
<table>
<tr><td></td><thfirst>Observed</thfirst><thspan/><thspan/></tr>
<tr><td></td><td></td><th>Event</th><th>No Event</th><th>Total</th></tr>
<tr><td></td><th>Event</th><td><in>tp</in></td><td><in>fp</in></td><td><in>totc</in></td></tr>
<tr><th>Classified</th><th>No Event</th><td><in>fn</in></td><td><in>tn</in></td><td><in>totnoc</in></td></tr>
<tr><td></td><th>Total</th><td><in>tote</in></td><td><in>totnoe</in></td><td></td></tr>
</table>

<p>cutoff = <in>co</in></p>

<p>sensitivity = <in>sens</in>%<br />
specificity = <in>spec</in>%</p>

<p>+ve predictive value = <in>+ve</in>%<br />
-ve predictive value = <in>npv</in>%<br />
predictive value despite -ve test = <in>-ve</in>%</p>

<p>correctly classified = <in>cc</in>%</p>

<p>likelihood ratio (<in>pc</in>% CI):<br />
LR (+ve) = <in>lr+</in> (<in>from+</in> to <in>to+</in>)<br />
LR (-ve) = <in>lr-</in> (<in>from-</in> to <in>to-</in>)</p>

<p> 'near' cut-off at max(sens+spec) = <in>cmax</in></p>

<p> area under ROC curve = <in>area</in></p>

<p><in>chart</in></p>
</report>]]>
    </report>
	</steps>
</operation>
