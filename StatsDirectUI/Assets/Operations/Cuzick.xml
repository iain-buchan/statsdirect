<?xml version="1.0" encoding="utf-8"?>
<operation xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns="http://www.statsdirect.com/schemas/Operation.xsd">
	<name>Cuzick</name>
  <friendly-name lang="en-GB">Cuzick's test for trend</friendly-name>
  <help chm-id="1221" />
  <steps>
    <settings>
      <parameters>
        <frame>
          <name>data</name>
          <prompt>Select data for trend test</prompt>
          <same-length>false</same-length>
          <mode>NumericReplaceMissing</mode>
          <min-columns>2</min-columns>
          <max-columns>200</max-columns>
          <ask-for-group-id>true</ask-for-group-id>
          <clear-selection-first>true</clear-selection-first>
        </frame>
        <boolean>
          <name>specify_group_scores</name>
          <prompt>Specify group scores?</prompt>
          <default-value>false</default-value>
        </boolean>
      </parameters>
    </settings>
		<builtin function-name="rptCuzick" />
		<report filename="cuzick.rtf" />
	</steps>
</operation>
