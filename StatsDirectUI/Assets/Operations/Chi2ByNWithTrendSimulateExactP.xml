<?xml version="1.0" encoding="utf-8"?>
<operation xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns="http://www.statsdirect.com/schemas/Operation.xsd">
	<name>Chi2byNWithTrendSimulateExactP</name>
	<friendly-name lang="en-GB">Simulate Exact P</friendly-name>
  <prerequisite-operation>Chi2byNLinearTrend</prerequisite-operation>
  <prerequisite-operation>Chi2byNWithTrend</prerequisite-operation>
  <help chm-id="1049" />
  <steps>
      <parameters>
        <integer>
          <name>iterations</name>
          <prompt>Iterations</prompt>
          <minimum-value>1</minimum-value>
          <default-value>1000000</default-value>
          <must-request>true</must-request>
        </integer>
        <integer>
          <name>seed</name>
          <prompt>Seed</prompt>
          <default-value>=Base.DefaultSeed()</default-value>
          <force-default>true</force-default>
          <must-request>true</must-request>
        </integer>
        <confidence-interval>
          <name>ci</name>
          <default-value>0.99</default-value>
          <must-request>true</must-request>
          <can-default>false</can-default>
        </confidence-interval>
        <!-- Should already be present due to the prerequisite operation, but let's force the issue -->
        <special>
          <name>data</name>
          <type>chi-3-column</type>
        </special>
      </parameters>
		<builtin function-name="rptChi2byNWithTrendSimulateExactP" />
    <report type="text/rtf" filename="chiTwoByKSimulatedExactP.rtf" />
    <report type="application/x-statsdirect-creole" filename="chiTwoByKSimulatedExactP.creole" />
  </steps>
</operation>
