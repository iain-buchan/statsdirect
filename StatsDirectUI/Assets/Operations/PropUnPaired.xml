<?xml version="1.0" encoding="utf-8"?>
<operation xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns="http://www.statsdirect.com/schemas/Operation.xsd">
	<name>PropUnPaired</name>
  <friendly-name lang="en-GB">Comparison of independent proportions</friendly-name>
  <help chm-id="1250" />
  <steps>
    <settings>
      <parameters>
        <double>
          <name>n1</name>
          <prompt>Total observations in SAMPLE 1</prompt>
          <minimum-value>0</minimum-value>
          <must-request>true</must-request>
        </double>
        <double>
          <name>r1</name>
          <prompt>Number responding in SAMPLE 1</prompt>
          <minimum-value>0</minimum-value>
          <must-request>true</must-request>
        </double>
        <double>
          <name>n2</name>
          <prompt>Total observations in SAMPLE 2</prompt>
          <minimum-value>0</minimum-value>
          <must-request>true</must-request>
        </double>
        <double>
          <name>r2</name>
          <prompt>Number responding in SAMPLE 2</prompt>
          <minimum-value>0</minimum-value>
          <must-request>true</must-request>
        </double>
        <confidence-interval>
          <name>cco</name>
          <must-request>true</must-request>
        </confidence-interval>
      </parameters>
    </settings>
  	<builtin function-name="rptPropUnPaired" />
	  <report filename="p_unpair.rtf" />
	</steps>
  <suggested-operations>
    <suggested-operation>PropUnPaired</suggested-operation>
  </suggested-operations>
</operation>
