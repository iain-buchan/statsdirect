<?xml version="1.0" encoding="utf-8"?>
<operation xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns="http://www.statsdirect.com/schemas/Operation.xsd">
	<name>RandomPairs</name>
  <friendly-name lang="en-GB">Intervention-control pair randomization</friendly-name>
  <help chm-id="1255" />
  <steps>
    <settings>
      <parameters>
        <integer>
          <name>pairs</name>
          <prompt>Intervention-control pairs to allocate</prompt>
          <must-request>true</must-request>
        </integer>
        <integer>
          <name>seed</name>
          <prompt>Seed (leave blank for automatic seed)</prompt>
          <must-request>true</must-request>
          <cancel-skips-parameter>Skip</cancel-skips-parameter>
        </integer>
        <boolean>
          <name>balance</name>
          <prompt>Try balanced allocation</prompt>
          <must-request>true</must-request>
        </boolean>
      </parameters>
    </settings>
  	<builtin function-name="rptRandomPairs" />
	  <report type="text/rtf" filename="r_pair.rtf" />
	</steps>
  <suggested-operations>
    <suggested-operation>RandomPairs</suggested-operation>
  </suggested-operations>
</operation>
