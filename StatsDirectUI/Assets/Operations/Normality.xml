<?xml version="1.0" encoding="utf-8"?>
<operation xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns="http://www.statsdirect.com/schemas/Operation.xsd">
	<name>Normality</name>
  <friendly-name lang="en-GB">Tests for signs of departure from normal distributions</friendly-name>
  <help chm-id="1243" />
  <steps>
    <settings>
      <parameters>
        <frame>
          <name>data</name>
          <same-length>false</same-length>
          <mode>NumericReplaceMissing</mode>
          <min-columns>1</min-columns>
          <max-columns>1</max-columns>
          <ask-for-group-id>false</ask-for-group-id>
        </frame>
      </parameters>
    </settings>
	  <builtin function-name="rptNormality" />
	  <report type="text/rtf" filename="normality.rtf" />
    <report type="text/rtf" filename="charts.rtf" />
  </steps>
</operation>
