<?xml version="1.0" encoding="utf-8"?>
<operation xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns="http://www.statsdirect.com/schemas/Operation.xsd">
	<name>MetaCalculationOptions</name>
  <friendly-name lang="en-GB">Meta-analysis calculation options</friendly-name>
  <help chm-id="1166" />
  <steps>
    <settings>
      <parameters>
        <boolean>
          <name>meta-exact</name>
          <prompt>Try exact methods (can be slow)</prompt>
          <default-value>=Host.Preferences.MetaExact</default-value>
        </boolean>
        <boolean>
          <name>meta-delay</name>
          <prompt>Delay continuity correction</prompt>
          <default-value>=Host.Preferences.DelayContinuityCorrection</default-value>
        </boolean>
        <option>
          <name>meta-cc</name>
          <prompt>Continuity correction for sparse tables</prompt>
          <prompt-precedes-parameter>true</prompt-precedes-parameter>
          <default-value>=Host.Preferences.MetaCC.ToString()</default-value>
          <format-type>Dropdown</format-type>
          <options>
            <option value="-9">Treatment arm</option>
            <option value="0.5">0.5</option>
            <option value="0.01">0.01</option>
          </options>
        </option>
      </parameters>
    </settings>
    <script language="CSharp">
  <![CDATA[
SDPreferences preferences = Host.Preferences;
preferences.MetaExact = Parameters["meta-exact"].AsBoolean;
preferences.DelayContinuityCorrection = Parameters["meta-delay"].AsBoolean;
preferences.MetaCC = Parsing.Cdbl_Txt(Parameters["meta-cc"].AsString);
return new ParameterBag();
    ]]></script>
	</steps>
</operation>
