<?xml version="1.0" encoding="utf-8"?>
<operation xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns="http://www.statsdirect.com/schemas/Operation.xsd">
	<name>EqualityOfVariance</name>
	<friendly-name lang="en-GB">Equality of variance (Levene, Bartlett) and Welch's F</friendly-name>
  <prerequisite-operation>OneWay</prerequisite-operation>
  <steps>
      <parameters>
        <frame>
          <name>data</name>
          <prompt>Select DATA</prompt>
          <mode>NumericReplaceMissing</mode>
          <min-columns>2</min-columns>
          <max-columns>200</max-columns>
          <ask-for-group-id>true</ask-for-group-id>
        </frame>
      </parameters>
		<builtin function-name="rptEqualityOfVariance" />
    <report type="application/x-statsdirect-creole">
      <![CDATA[<report>
<title>Approximate equality of variance tests and adjusted ANOVA</title>

<p>Levene's (W50) F = <inx>f</inx>  (df = <in>df1</in>, <in>df2</in>)  <pval><inp>pLevene</inp></pval></p>

<p>Bartlett's chi-square = <inx>x2</inx>  df = <in>df</in>  <pval><inp>pBartlett</inp></pval></p>

<p>Welch adjusted ANOVA F = <inx>fWelch</inx>  (df = <in>dfnWelch</in>, <inx>dfdWelch</inx>)  <pval><inp>pWelch</inp></pval></p>
</report>]]>
    </report>
	</steps>
</operation>
