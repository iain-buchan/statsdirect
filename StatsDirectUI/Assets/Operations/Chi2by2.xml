<?xml version="1.0" encoding="utf-8"?>
<operation xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns="http://www.statsdirect.com/schemas/Operation.xsd">
	<name>Chi2by2</name>
  <friendly-name lang="en-GB">Chi-square 2-by-2 table test</friendly-name>
  <help chm-id="1048" />
  <steps>
      <parameters>
        <double-2-by-2>
          <name>scrap</name>
          <columns-prompt>Characteristic (press F1 for an example)</columns-prompt>
          <left-column-prompt>Present</left-column-prompt>
          <right-column-prompt>Absent</right-column-prompt>
          <rows-prompt>Outcome:</rows-prompt>
          <top-row-prompt>Present</top-row-prompt>
          <bottom-row-prompt>Absent</bottom-row-prompt>
          <top-left-name>a</top-left-name>
          <top-right-name>b</top-right-name>
          <bottom-left-name>c</bottom-left-name>
          <bottom-right-name>d</bottom-right-name>
          <must-request>true</must-request>
        </double-2-by-2>
        <confidence-interval>
          <name>cco</name>
          <must-request>true</must-request>
        </confidence-interval>
        <option>
          <name>study_type</name>
          <prompt>Which type of study produced your data?</prompt>
          <options>
            <option value="casecontrol">Case-control study</option>
            <option value="cohort">Cohort study</option>
            <option value="neither">Neither</option>
          </options>
          <default-value>casecontrol</default-value>
          <must-request>true</must-request>
        </option>
        <boolean>
          <name>doFisher</name>
          <prompt>Calculate Fisher exact test as well?</prompt>
          <acquire-if-true>=parameters.ContainsKey("study_type") &amp;&amp; !"casecontrol".Equals(parameters["study_type"].AsString)</acquire-if-true>
          <default-value>false</default-value>
          <must-request>true</must-request>
        </boolean>
      </parameters>
  	<builtin function-name="rptChi2by2" />
    <report type="application/x-statsdirect-creole">
      <![CDATA[
<report>
<title>Chi-square test (2 by 2)</title>
<br />
<subtitle>Observed values and totals:</subtitle>
<table>
<tr><td>@tab3_a1</td><td>@tab3_b1</td><td><subtotal>@tab3_c1</subtotal></td></tr>
<tr><td>@tab3_a2</td><td>@tab3_b2</td><td><subtotal>@tab3_c2</subtotal></td></tr>
<tr><td><subtotal>@tab3_a3</subtotal></td><td><subtotal>@tab3_b3</subtotal></td><td><grandtotal>@tab3_c3</grandtotal></td></tr>
</table>
<br />
<subtitle>Expected values:</subtitle>
<table>
<tr><td>@tab_a1</td><td>@tab_b1</td></tr>
<tr><td>@tab_a2</td><td>@tab_b2</td></tr>
</table>

<p>Uncorrected Chi&#xb2; = @chi  <pval>@{chi_p:pval}</pval><br />
Yates-corrected Chi&#xb2; = @yates_chi  <pval>@{yates_chi_p:pval}</pval></p>

<p>Measures of association:<br />
Pearson's contingency = @pearson<br />
Cram&#xe9;r's <i>V</i> (signed) = @vs</p>
<block name="warn">

<p><warn>@wrn too small for chi-square, please use Fisher's exact test instead</warn></p>
</block>
</report>
<block name="odds"><include src="odds.creole"/></block>
<block name="relrisk"><include src="relrisk.creole"/></block>
<block name="fisher"><include src="fisher.creole"/></block>
]]></report>
	</steps>
  <suggested-operations>
    <suggested-operation>Chi2by2</suggested-operation>
  </suggested-operations>
</operation>
