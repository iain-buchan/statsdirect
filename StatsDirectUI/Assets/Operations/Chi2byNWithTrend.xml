<?xml version="1.0" encoding="utf-8"?>
<operation xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns="http://www.statsdirect.com/schemas/Operation.xsd">
	<name>Chi2byNWithTrend</name>
  <friendly-name lang="en-GB">Chi-square 2-by-k test with user-defined scores for trend</friendly-name>
  <help chm-id="1049" />
  <steps>
    <settings>
      <parameters>
        <special>
          <name>data</name>
          <must-request>true</must-request>
          <type>chi-3-column</type>
        </special>
        <boolean>
          <name>doExactP</name>
          <prompt>Simulate exact P?</prompt>
          <column>2</column>
          <must-request>true</must-request>
        </boolean>
        <integer>
          <name>iterations</name>
          <prompt>Iterations</prompt>
          <acquire-if-true>=Parameters.ContainsKey("doExactP") &amp;&amp; Parameters["doExactP"].AsBoolean</acquire-if-true>
          <column>2</column>
          <must-request>true</must-request>
          <minimum-value>1</minimum-value>
          <default-value>1000000</default-value>
        </integer>
        <integer>
          <name>seed</name>
          <prompt>Seed</prompt>
          <acquire-if-true>=Parameters.ContainsKey("doExactP") &amp;&amp; Parameters["doExactP"].AsBoolean</acquire-if-true>
          <column>2</column>
          <must-request>true</must-request>
          <force-default>true</force-default>
          <default-value>=Base.DefaultSeed()</default-value>
        </integer>
        <confidence-interval>
          <name>ci</name>
          <acquire-if-true>=Parameters.ContainsKey("doExactP") &amp;&amp; Parameters["doExactP"].AsBoolean</acquire-if-true>
          <column>2</column>
          <must-request>true</must-request>
          <default-value>0.99</default-value>
          <can-default>false</can-default>
          <can-use-standard>false</can-use-standard>
        </confidence-interval>
      </parameters>
    </settings>
  	<builtin function-name="rptChi2byNWithTrend" />
	  <report filename="chi2xc.rtf" />
    <test>
      <condition>=Parameters.ContainsKey("doExactP") &amp;&amp; Parameters["doExactP"].AsBoolean</condition>
      <iftrue>
        <builtin function-name="rptChi2byNWithTrendSimulateExactP" />
        <report filename="chiTwoByKSimulatedExactP.rtf" />
      </iftrue>
    </test>
  </steps>
  <suggested-operations>
    <suggested-operation>Chi2byNWithTrend</suggested-operation>
  </suggested-operations>
</operation>
