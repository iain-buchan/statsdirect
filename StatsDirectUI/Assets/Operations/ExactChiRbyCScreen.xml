<?xml version="1.0" encoding="utf-8"?>
<operation xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns="http://www.statsdirect.com/schemas/Operation.xsd">
	<name>ExactChiRbyCScreen</name>
  <friendly-name lang="en-GB">R-by-c contingency table tests</friendly-name>
  <help chm-id="1055" />
  <steps>
    <settings>
      <parameters>
        <frame>
          <name>data</name>
          <prompt/>
          <min-columns>2</min-columns>
          <max-columns>200</max-columns>
          <same-length>true</same-length>
          <mode>NumericReplaceMissing</mode>
          <must-request>true</must-request>
          <can-select>false</can-select>
        </frame>
        <confidence-interval>
          <name>cco</name>
        </confidence-interval>
      </parameters>
    </settings>
  	<builtin function-name="rptChiRbyC" />
	  <report filename="chirxc.rtf" />
	</steps>
  <suggested-operations>
    <suggested-operation>ExactChiRbyCScreen</suggested-operation>
  </suggested-operations>
</operation>
