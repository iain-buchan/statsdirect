<?xml version="1.0" encoding="utf-8"?>
<operation xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns="http://www.statsdirect.com/schemas/Operation.xsd">
	<name>Rotate</name>
	<friendly-name lang="en-GB">Rotate data block</friendly-name>
  <help chm-id="1084" />
  <steps>
    <settings>
      <parameters>
        <option>
          <name>use-formulae</name>
          <prompt>Select what happens to formulae in the rotated block</prompt>
          <default-value>results</default-value>
          <options>
            <option value="formulae">Maintain formulae</option>
            <option value="results">Rotate results only</option>
          </options>
        </option>
      </parameters>
    </settings>
    <test>
      <condition>="formulae".Equals(parameters["use-formulae"].AsString)</condition>
      <iftrue>
        <settings>
          <parameters>
            <frame>
              <name>data</name>
              <prompt>Select data to ROTATE</prompt>
              <mode>TextWithFormulae</mode>
              <min-columns>1</min-columns>
              <max-columns>256</max-columns>
            </frame>
          </parameters>
        </settings>
        <builtin function-name="shtRotate"/>
        <output-frame frame-name="output" formulae="true" />
      </iftrue>
      <iffalse>
        <settings>
          <parameters>
            <frame>
              <name>data</name>
              <prompt>Select data to ROTATE</prompt>
              <mode>TextNoTitles</mode>
              <min-columns>1</min-columns>
              <max-columns>256</max-columns>
            </frame>
          </parameters>
        </settings>
        <builtin function-name="shtRotate"/>
        <output-frame frame-name="output" />
      </iffalse>
    </test>
	</steps>
</operation>
