<?xml version="1.0" encoding="utf-8"?>
<operation xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns="http://www.statsdirect.com/schemas/Operation.xsd">
	<name>RiskDifference</name>
  <friendly-name lang="en-GB">Meta-analysis of risk differences</friendly-name>
  <help chm-id="1170" />
  <steps>
    <settings>
      <parameters>
        <confidence-interval>
          <name>gamma</name>
        </confidence-interval>
        <frame>
          <name>sn</name>
          <prompt>Select TOTAL numbers of subjects in EXPERIMENTAL/TREATED groups</prompt>
          <mode>NumericSkipMissing</mode>
          <min-columns>1</min-columns>
          <max-columns>1</max-columns>
          <clear-selection-first>true</clear-selection-first>
        </frame>
        <frame>
          <name>sr</name>
          <prompt>Select numbers of EXPERIMENTAL/TREATED subjects with DISEASE/OUTCOME</prompt>
          <same-length-as>sn</same-length-as>
          <mode>NumericSkipMissing</mode>
          <min-columns>1</min-columns>
          <max-columns>1</max-columns>
          <clear-selection-first>true</clear-selection-first>
        </frame>
        <frame>
          <name>xn</name>
          <prompt>Select TOTAL numbers of subjects in CONTROL groups</prompt>
          <same-length-as>sn</same-length-as>
          <mode>NumericSkipMissing</mode>
          <min-columns>1</min-columns>
          <max-columns>1</max-columns>
          <clear-selection-first>true</clear-selection-first>
        </frame>
        <frame>
          <name>xr</name>
          <prompt>Select numbers of CONTROL subjects with DISEASE/OUTCOME</prompt>
          <same-length-as>sn</same-length-as>
          <mode>NumericSkipMissing</mode>
          <min-columns>1</min-columns>
          <max-columns>1</max-columns>
          <clear-selection-first>true</clear-selection-first>
        </frame>
        <frame>
          <name>strata</name>
          <prompt>Select stratum LABELS [Default for default]</prompt>
          <cancel-skips-parameter>Default</cancel-skips-parameter>
          <same-length-as>sn</same-length-as>
          <mode>Text</mode>
          <min-columns>1</min-columns>
          <max-columns>1</max-columns>
          <clear-selection-first>true</clear-selection-first>
        </frame>
      </parameters>
    </settings>
		<builtin function-name="rptRiskDifferenceMeta" />
		<report type="text/rtf" filename="rdmeta.rtf" />
		<report type="text/rtf" filename="charts.rtf" />
	</steps>
</operation>
