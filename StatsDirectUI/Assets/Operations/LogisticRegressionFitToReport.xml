<?xml version="1.0" encoding="utf-8"?>
<operation xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns="http://www.statsdirect.com/schemas/Operation.xsd">
	<name>LogisticRegressionFitToReport</name>
	<friendly-name lang="en-GB">Fits and residuals</friendly-name>
  <prerequisite-operation>LogisticRegression</prerequisite-operation>
  <steps>
    <test>
      <condition>="individual".Equals(parameters["grouping"].AsString)</condition>
      <iftrue>
          <parameters>
            <option>
              <name>row_type</name>
              <prompt>Output</prompt>
              <must-request>true</must-request>
              <format-type>Radio</format-type>
              <default-value>covariatePatterns</default-value>
              <options>
                <option value="covariatePatterns">Covariate patterns</option>
                <option value="individual">Individual observations</option>
              </options>
            </option>
          </parameters>
      </iftrue>
    </test>
    <builtin function-name="rptLogisticRegressionFit" />
    <report type="application/x-statsdirect-creole">
      <![CDATA[
<report>
<title>Logistic regression - fits and residuals</title>
<block name="grouped">
<table>
<br />
<tr><th>Index</th><block name="predictors"><th><in>lab</in></th></block></tr>
<block name="predictorValues"><tr><td><in>idx</in></td><block name="pred"><td><in>val</in></td></block></tr>
</block></table>
<br />
<table>
<tr><th>Index</th><th>Trials</th><th>Events</th><th>Event Probability</th><th>Deviance Residual</th></tr>
<block name="predictorValues"><tr><td><in>idx</in></td><td><in>sub</in></td><td><in>res</in></td><td><in>fit</in></td><td><in>dev</in></td></tr>
</block></table>
<br />
<table>
<tr><th>Index</th><th>Pearson Residual</th><th>Leverage</th><th>Std Pearson Residual</th></tr>
<block name="predictorValues"><tr><td><in>idx</in></td><td><in>pres</in></td><td><in>lev</in></td><td><in>spres</in></td></tr>
</block></table>
<br />
<table>
<tr><th>Index</th><th>Delta Beta</th><th>Std Delta Beta</th><th>Delta Deviance</th><th>Delta Chi-square</th></tr>
<block name="predictorValues"><tr><td><in>idx</in></td><td><in>deltac</in></td><td><in>deltabar</in></td><td><in>deltadev</in></td><td><in>deltachi</in></td></tr>
</block></table>
</block>
<block name="individual">
<br />
<table>
<tr><th>Index</th><th>Response</th><th>Event Probability</th><th>Deviance Residual</th></tr>
<block name="predictorValues"><tr><td><in>resnum</in></td><td><in>resbool</in></td><td><in>fit</in></td><td><in>dev</in></td></tr>
</block></table>
<br />
<table>
<tr><th>Index</th><th>Pearson Residual</th><th>Leverage</th><th>Std Pearson Residual</th></tr>
<block name="predictorValues"><tr><td><in>resnum</in></td><td><in>pres</in></td><td><in>lev</in></td><td><in>spres</in></td></tr>
</block></table>
<br />
<table>
<tr><th>Index</th><th>Delta Beta</th><th>Std Delta Beta</th><th>Delta Deviance</th><th>Delta Chi-square</th></tr>
<block name="predictorValues"><tr><td><in>resnum</in></td><td><in>deltac</in></td><td><in>deltabar</in></td><td><in>deltadev</in></td><td><in>deltachi</in></td></tr>
</block></table>
</block>
<br />
<table>
<tr><th>Parameters</th><th>Covariance</th></tr>
<block name="covar"><tr><td><in>lab</in></td><td><in>cov</in></td></tr>
</block></table>
</report>]]>
    </report>
  </steps>
</operation>
