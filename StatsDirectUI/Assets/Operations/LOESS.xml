<?xml version="1.0" encoding="utf-8"?>
<operation xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns="http://www.statsdirect.com/schemas/Operation.xsd">
	<name>LOESS</name>
  <friendly-name lang="en-GB">LOESS curve fitting</friendly-name>
  <help chm-id="1380" />
  <steps>
    <settings>
      <parameters>
        <frame>
          <name>outcome</name>
          <prompt>Select data for OUTCOME (Y axis)</prompt>
          <must-request>true</must-request>
          <mode>NumericReplaceMissing</mode>
          <min-columns>1</min-columns>
          <max-columns>1</max-columns>
          <clear-selection-first>true</clear-selection-first>
        </frame>
        <frame>
          <name>predictors</name>
          <prompt>Select data for PREDICTOR(S) (X axis(, Z axis etc.))</prompt>
          <must-request>true</must-request>
          <mode>NumericReplaceMissing</mode>
          <min-columns>1</min-columns>
          <max-columns>4</max-columns>
          <same-length-as>outcome</same-length-as>
          <clear-selection-first>true</clear-selection-first>
        </frame>
        <string>
          <name>model</name>
          <prompt>Formula</prompt>
          <must-request>true</must-request>
          <default-value>=RConvert.ToRVariableName(parameters["outcome"].AsDataFrame.Variables[0].Title) + "~" + parameters["predictors"].AsDataFrame.Variables.Select(v => RConvert.ToRVariableName(v.Title)).Aggregate((names, name) => names + "+" + name)</default-value>
        </string>
        <string>
          <name>title</name>
          <prompt>Chart title</prompt>
          <must-request>true</must-request>
          <acquire-if-true>=parameters["predictors"].AsDataFrame.Variables.Count == 1</acquire-if-true>
          <default-value>=parameters["outcome"].AsDataFrame.Variables[0].Title + " vs. " + parameters["predictors"].AsDataFrame.Variables[0].Title</default-value>
        </string>
        <string>
          <name>ylab</name>
          <prompt>Y-axis label</prompt>
          <must-request>true</must-request>
          <acquire-if-true>=parameters["predictors"].AsDataFrame.Variables.Count == 1</acquire-if-true>
          <default-value>=parameters["outcome"].AsDataFrame.Variables[0].Title</default-value>
        </string>
        <string>
          <name>xlab</name>
          <prompt>X-axis label</prompt>
          <must-request>true</must-request>
          <acquire-if-true>=parameters["predictors"].AsDataFrame.Variables.Count == 1</acquire-if-true>
          <default-value>=parameters["predictors"].AsDataFrame.Variables[0].Title</default-value>
        </string>
        <double>
          <name>span</name>
          <prompt>Span (amount of smoothing)</prompt>
          <must-request>true</must-request>
          <default-value>0.75</default-value>
          <minimum-value>0</minimum-value>
          <maximum-value>1</maximum-value>
        </double>
        <option>
          <name>degree</name>
          <prompt>Degree (polynomial)</prompt>
          <must-request>true</must-request>
          <options>
            <option value="1">1</option>
            <option value="2">2</option>
          </options>
          <default-value>1</default-value>
        </option>
        <boolean>
          <name>plotFits</name>
          <prompt>Plot fits</prompt>
          <must-request>true</must-request>
          <acquire-if-true>=parameters["predictors"].AsDataFrame.Variables.Count == 1</acquire-if-true>
          <default-value>false</default-value>
        </boolean>
        <boolean>
          <name>plotFitsAndCi</name>
          <prompt>Plot fits and confidence interval</prompt>
          <must-request>true</must-request>
          <acquire-if-true>=parameters["predictors"].AsDataFrame.Variables.Count == 1</acquire-if-true>
          <default-value>true</default-value>
        </boolean>
        <confidence-interval>
          <name>ci</name>
          <acquire-if-true>=parameters["plotFitsAndCi"].AsBoolean</acquire-if-true>
        </confidence-interval>
        <boolean>
          <name>saveFitsAndSe</name>
          <prompt>Save fits and standard errors</prompt>
          <must-request>true</must-request>
          <default-value>false</default-value>
        </boolean>
<!--        <boolean>
          <name>saveRScript</name>
          <prompt>Save R script</prompt>
          <must-request>true</must-request>
          <default-value>false</default-value>
        </boolean> -->
      </parameters>
    </settings>
    <script language="R"><![CDATA[
m<-loess(model,span=span,degree=degree)
p<-predict(m,se=T)

gr1<-file.path(getwd(),"metafile1.wmf")
win.metafile(gr1)
plot(predictors[[1]],outcome[[1]],main=title,ylab=ylab,xlab=xlab)
lines(predictors[[1]],p$fit)
lines(predictors[[1]],p$fit+2*p$s, lty=2)
lines(predictors[[1]],p$fit-2*p$s, lty=2)
suppressWarnings(dev.off())

r1<-data.frame(observations=m$n,parameters=m$enp,residualse=m$s,df=p$df)
rn<-data.frame(residuals=m$residuals,fits=m$fitted,sefits=p$se.fit)
op<-file("results.txt")
writeLines(c("start~names",colnames(r1),"start~data",as.character(r1),"start~names",colnames(rn),"start~data",as.character(rn),"start~graphics",paste('"', gr1, '"')),op)
close(op)
]]></script>
    <test>
      <condition>=parameters["saveFitsAndSe"].AsBoolean</condition>
      <iftrue>
        <settings>
          <parameters>
            <special>
              <name>solo</name>
              <prompt>Pick the sheet in which you want the fits and standard errors to appear</prompt>
              <type>frame</type>
            </special>
          </parameters>
        </settings>
        <output-frame frame-name="fits" keep-selection="true" />
        <output-frame frame-name="sefits" keep-selection="true" />
      </iftrue>
    </test>
    <report type="application/x-statsdirect-creole">
  <![CDATA[
<report>
<line><title>LOESS Curve Fitting</title></line>
<line></line>
<line><in>title</in></line>
<line>Number of Observations: <in>observations</in></line>
<line>Equivalent Number of Parameters: <in>parameters</in></line>
<line>Residual Standard Error: <in>residualse</in></line>
<line></line>
<line><in>metafile1</in></line>
</report>
]]>
    </report>
  </steps>
</operation>
