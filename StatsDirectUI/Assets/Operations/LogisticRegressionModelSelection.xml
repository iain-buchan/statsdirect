<?xml version="1.0" encoding="utf-8"?>
<operation xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns="http://www.statsdirect.com/schemas/Operation.xsd">
	<name>LogisticRegressionModelSelection</name>
	<friendly-name lang="en-GB">Model selection</friendly-name>
  <prerequisite-operation>LogisticRegression</prerequisite-operation>
  <steps>
    <settings>
      <parameters>
        <confidence-interval>
          <name>gamma</name>
        </confidence-interval>
      </parameters>
    </settings>
		<builtin function-name="rptLogisticRegressionModelSelection" />
