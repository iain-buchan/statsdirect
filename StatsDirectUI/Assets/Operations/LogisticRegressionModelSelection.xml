      <![CDATA[<report>
<line><title>Logistic regression - model selection guide</title></line>
<line></line>
<line>Note: This is a guide to the amount of statistical information your variables add to the regression. It is not an automatic model selection procedure. There is no substitute for thinking about the real-world meaning of models.</line>
<line></line>
<line><model><u>Model (~NS denotes coefficient P>0.2; ~?NS 0.05<P<0.2)</u></model></line>
<table>
<tr><th>Akaike Information</th><th>McFadden R-square</th><th>Significant coefficients</th><thfirst>LR Goodness of Fit</thfirst><thspan/></tr>
<block name="parameters"><tr><tdfirst><model><in>model</in></model></tdfirst><tdspan/><tdspan/><tdspan/><tdspan/></tr>
<tr><td><in>aic</in></td><td><in>r2</in></td><td><in>scoef</in> / <in>ncoef</in></td><td><in>x2dev</in></td><td><pval><in>p_dev</in></pval></td></tr>
</block>
</table>
</report>]]></report>
	</steps>
</operation>
