<?xml version="1.0" encoding="utf-8"?>
<operation xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns="http://www.statsdirect.com/schemas/Operation.xsd">
	<name>WeiLachin</name>
  <friendly-name lang="en-GB">Wei-Lachin test</friendly-name>
  <help chm-id="1327" />
  <steps>
    <settings>
      <parameters>
        <frame>
          <name>gid</name>
          <prompt>Select data for GROUP IDENTIFIER</prompt>
          <same-length>false</same-length>
          <mode>CategoryReplaceMissing</mode>
          <min-columns>1</min-columns>
          <max-columns>1</max-columns>
          <clear-selection-first>true</clear-selection-first>
          <validators>
            <validator>TwoBinsAndNoMissingData</validator>
          </validators>
        </frame>
        <integer>
          <name>nr</name>
          <prompt>Number of repeat times</prompt>
          <minimum-value>1</minimum-value>
          <default-value>1</default-value>
        </integer>
      </parameters>
    </settings>
		<!-- Construct two frames, "times" and "censor", with variables[0..nr - 1] for each of the repeats -->
		<iteration>
			<lower-bound>1</lower-bound>
			<upper-bound-parameter>nr</upper-bound-parameter>
			<loop-variable-name>repeat</loop-variable-name>
			<steps>
        <settings>
          <parameters>
            <frame>
              <name>scrapTimes</name>
              <prompt>="Select data for TIMES (repeat " + Parameters["repeat"].Data.ToString() + ")"</prompt>
              <same-length-as>gid</same-length-as>
              <mode>NumericReplaceMissing</mode>
              <min-columns>1</min-columns>
              <max-columns>1</max-columns>
              <append-to-grid>times</append-to-grid>
              <clear-selection-first>true</clear-selection-first>
              <must-request>true</must-request>
            </frame>
            <frame>
              <name>scrapCensor</name>
              <prompt>="Select data for CENSORSHIP (repeat " + Parameters["repeat"].Data.ToString() + ")"</prompt>
              <same-length-as>gid</same-length-as>
              <mode>NumericReplaceMissing</mode>
              <min-columns>1</min-columns>
              <max-columns>1</max-columns>
              <validators>
                <validator>Boolean</validator>
              </validators>
              <validation-fail-message>Censorship value must be 0 or 1 only</validation-fail-message>
              <append-to-grid>censor</append-to-grid>
              <clear-selection-first>true</clear-selection-first>
              <must-request>true</must-request>
            </frame>
          </parameters>
        </settings>
			</steps>
		</iteration>
		<builtin function-name="rptWeiLachin" />
		<report filename="wei.rtf" />
	</steps>
</operation>
