<?xml version="1.0" encoding="utf-8"?>
<operation xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns="http://www.statsdirect.com/schemas/Operation.xsd">
	<name>PolynomialAreaUnderCurve</name>
	<friendly-name lang="en-GB">Area under curve</friendly-name>
	<steps>
    <settings>
      <parameters>
        <frame>
          <name>y</name>
          <prompt>Select data for OUTCOME (Y axis)</prompt>
          <mode>NumericReplaceMissing</mode>
          <min-columns>1</min-columns>
          <max-columns>1</max-columns>
          <clear-selection-first>true</clear-selection-first>
        </frame>
        <frame>
          <name>x</name>
          <prompt>Select data for PREDICTOR (X axis)</prompt>
          <mode>NumericReplaceMissing</mode>
          <same-length-as>y</same-length-as>
          <min-columns>1</min-columns>
          <max-columns>1</max-columns>
          <clear-selection-first>true</clear-selection-first>
        </frame>
      </parameters>
    </settings>
		<builtin function-name="rptAreaUnderCurve" />
		<report filename="poly_auc.rtf" />
	</steps>
</operation>
