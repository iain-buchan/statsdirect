<?xml version="1.0" encoding="utf-8"?>
<operation xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns="http://www.statsdirect.com/schemas/Operation.xsd">
	<name>Frequency</name>
  <friendly-name lang="en-GB">Frequency (counts) analysis</friendly-name>
  <help chm-id="1044" />
  <steps>
    <settings>
      <parameters>
        <frame>
          <name>data</name>
          <prompt>Select data for FREQUENCY ANALYSIS</prompt>
          <mode>CategoryReplaceMissing</mode>
          <min-columns>1</min-columns>
          <max-columns>200</max-columns>
          <ask-for-group-id>true</ask-for-group-id>
        </frame>
      </parameters>
    </settings>
		<builtin function-name="rptFrequency" />
		<report type="text/rtf" filename="freq.rtf" />
	</steps>
</operation>
