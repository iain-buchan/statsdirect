<?xml version="1.0" encoding="utf-8"?>
<operation xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns="http://www.statsdirect.com/schemas/Operation.xsd">
	<name>Probit</name>
  <friendly-name lang="en-GB">Probit (dose response) analysis</friendly-name>
  <help chm-id="1283" />
  <steps>
    <settings>
      <parameters>
        <frame>
          <name>dose</name>
          <prompt>Select data for DOSE levels</prompt>
          <same-length>false</same-length>
          <mode>NumericReplaceMissing</mode>
          <min-columns>1</min-columns>
          <max-columns>1</max-columns>
          <clear-selection-first>true</clear-selection-first>
        </frame>
        <frame>
          <name>subjects</name>
          <prompt>Select data for SUBJECTS at each dose level</prompt>
          <same-length-as>dose</same-length-as>
          <mode>NumericReplaceMissing</mode>
          <min-columns>1</min-columns>
          <max-columns>1</max-columns>
          <clear-selection-first>true</clear-selection-first>
        </frame>
        <frame>
          <name>responders</name>
          <prompt>Select data for RESPONDERS at each dose level</prompt>
          <same-length-as>dose</same-length-as>
          <mode>NumericReplaceMissing</mode>
          <min-columns>1</min-columns>
          <max-columns>1</max-columns>
          <clear-selection-first>true</clear-selection-first>
        </frame>
      </parameters>
    </settings>
    <builtin function-name="ProbitOrLogitDataHasControls"/>
    <settings>
      <parameters>
        <integer>
          <name>nc</name>
          <prompt>How many control subjects do you have?</prompt>
          <acquire-if-true>=!(Parameters.ContainsKey("dataHasControls") &amp;&amp; Parameters["dataHasControls"].AsBoolean)</acquire-if-true>
          <minimum-value>0</minimum-value>
        </integer>
        <integer>
          <name>nrc</name>
          <prompt>How many control subjects responded?</prompt>
          <acquire-if-true>=(!(Parameters.ContainsKey("dataHasControls") &amp;&amp; Parameters["dataHasControls"].AsBoolean)) &amp;&amp; (Parameters.ContainsKey("nc") &amp;&amp; Parameters["nc"].AsInt32 > 0)</acquire-if-true>
          <minimum-value>0</minimum-value>
          <!-- <maximum-value>=Parameters["nc"].AsInt32</maximum-value> -->
        </integer>
        <boolean>
          <name>calc-log10-doses</name>
          <prompt>Calculate log10 of doses</prompt>
          <default-value>true</default-value>
        </boolean>
        <confidence-interval>
          <name>conf</name>
        </confidence-interval>
        <double>
          <name>qld</name>
          <rubric>Two values are calculated for the independent variable (Dose, Stimulus etc.). The first gives 50% proportional response (ED50, LD50 etc) and the other X%.</rubric>
          <prompt>Enter the other centile (X)</prompt>
          <minimum-value>0</minimum-value>
          <maximum-value>100</maximum-value>
          <default-value>90</default-value>
        </double>
      </parameters>
    </settings>
		<builtin function-name="rptProbit" />
		<report filename="probit.rtf" />
	</steps>
  <suggested-operations>
    <suggested-operation>ProbitPlot</suggested-operation>
    <suggested-operation>ProbitInterpolateX</suggested-operation>
    <suggested-operation>ProbitInterpolateY</suggested-operation>
    <suggested-operation>ProbitMore</suggested-operation>
  </suggested-operations>
</operation>
