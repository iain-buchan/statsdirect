<?xml version="1.0" encoding="utf-8"?>
<operation xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns="http://www.statsdirect.com/schemas/Operation.xsd">
	<name>LogisticRegression</name>
  <friendly-name lang="en-GB">Logistic regression</friendly-name>
  <help chm-id="1276" />
  <steps>
    <settings>
      <parameters>
        <option>
          <name>grouping</name>
          <prompt>Response data</prompt>
          <columns>1</columns>
          <default-value>individual</default-value>
          <lifetime>SessionForThisOperation</lifetime>
          <options>
            <option value="grouped">Grouped (i.e. r out of n responded with covariates in row i)</option>
            <option value="individual">Individual (i.e. 0 [not responded]  or 1 [responded] for individual i in row i)</option>
          </options>
        </option>
        <string>
          <name>accuracy</name>
          <prompt>Precision of estimates:</prompt>
          <lifetime>SessionForThisOperation</lifetime>
          <prompt-precedes-parameter>true</prompt-precedes-parameter>
          <maximum-length>12</maximum-length>
          <default-value>="0.0000001"</default-value>
        </string>
        <boolean>
          <name>intercept</name>
          <prompt>Calculate intercepts</prompt>
          <lifetime>SessionForThisOperation</lifetime>
          <default-value>true</default-value>
        </boolean>
        <boolean>
          <name>weights</name>
          <prompt>Use weights for responses</prompt>
          <lifetime>SessionForThisOperation</lifetime>
          <default-value>false</default-value>
        </boolean>
      </parameters>
    </settings>
	<test>
		<condition>="grouped".Equals(Parameters["grouping"].AsString)</condition>
		<iftrue>
			<!-- grouped -->
      <settings>
        <parameters>
          <frame>
            <name>total</name>
            <prompt>Select data for TOTAL number</prompt>
            <same-length>false</same-length>
            <mode>NumericReplaceMissing</mode>
            <min-columns>1</min-columns>
            <max-columns>1</max-columns>
            <clear-selection-first>true</clear-selection-first>
          </frame>
          <frame>
            <name>response</name>
            <prompt>Select data for the RESPONSE</prompt>
            <same-length>true</same-length>
            <same-length-as>total</same-length-as>
            <mode>NumericReplaceMissing</mode>
            <min-columns>1</min-columns>
            <max-columns>1</max-columns>
            <clear-selection-first>true</clear-selection-first>
          </frame>
        </parameters>
      </settings>
		</iftrue>
		<iffalse>
			<!-- Individual -->
      <settings>
        <parameters>
          <frame>
            <name>response</name>
            <prompt>Select data for the RESPONSE</prompt>
            <same-length>false</same-length>
            <mode>NumericReplaceMissing</mode>
            <min-columns>1</min-columns>
            <max-columns>1</max-columns>
            <clear-selection-first>true</clear-selection-first>
          </frame>
        </parameters>
      </settings>
		</iffalse>
	</test>
	<!-- Either - note that there will always be a response frame to be the same length as! -->
	<test>
		<condition>=Parameters["weights"].AsBoolean</condition>
		<iftrue>
			<!-- grouped -->
      <settings>
        <parameters>
          <frame>
            <name>weight</name>
            <prompt>Select data for PRIOR WEIGHTS (skip for none)</prompt>
            <cancel-skips-parameter>Skip</cancel-skips-parameter>
            <same-length>true</same-length>
            <same-length-as>response</same-length-as>
            <mode>NumericReplaceMissing</mode>
            <min-columns>1</min-columns>
            <max-columns>1</max-columns>
            <clear-selection-first>true</clear-selection-first>
          </frame>
        </parameters>
      </settings>
		</iftrue>
	</test>
    <settings>
      <parameters>
        <frame>
          <name>predictors</name>
          <prompt>Select data for PREDICTORS</prompt>
          <validator>CheckForNonDummiedCategories</validator>
          <same-length>true</same-length>
          <same-length-as>response</same-length-as>
          <mode>NumericReplaceMissing</mode>
          <min-columns>1</min-columns>
          <max-columns>200</max-columns>
          <clear-selection-first>true</clear-selection-first>
        </frame>
      </parameters>
    </settings>
	<builtin function-name="rptLogisticRegression" />
	<report filename="logreg.rtf" />
	</steps>
  <suggested-operations>
    <suggested-operation>LogisticRegressionFitToReport</suggested-operation>
    <suggested-operation>LogisticRegressionFitToWorksheet</suggested-operation>
    <suggested-operation>LogisticRegressionDiagnostics</suggested-operation>
    <suggested-operation>LogisticRegressionModel</suggested-operation>
    <suggested-operation>LogisticRegressionOdds</suggested-operation>
    <suggested-operation>LogisticRegressionClassification</suggested-operation>
    <suggested-operation>LogisticRegressionBootstrap</suggested-operation>
    <suggested-operation>LogisticRegressionPrediction</suggested-operation>
  </suggested-operations>
</operation>
