<?xml version="1.0" encoding="utf-8"?>
<operation xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns="http://www.statsdirect.com/schemas/Operation.xsd">
	<name>TimeSeriesSummary</name>
	<friendly-name lang="en-GB">Time Series Summary</friendly-name>
  <help chm-id="1399" />
  <steps>
      <parameters>
        <frame>
          <name>times</name>
          <prompt>Select Data for Times of Observation</prompt>
          <validators>
            <validator>NoMissingData</validator>
            <validator>NonNegative</validator>
          </validators>
          <mode>NumericReplaceMissing</mode>
          <min-columns>1</min-columns>
          <max-columns>1</max-columns>
          <ask-for-group-id>false</ask-for-group-id>
          <clear-selection-first>true</clear-selection-first>
        </frame>
        <frame>
          <name>observations</name>
          <prompt>Select Data for Observations</prompt>
          <mode>NumericReplaceMissing</mode>
          <same-length-as>times</same-length-as>
          <min-columns>1</min-columns>
          <max-columns>1</max-columns>
          <ask-for-group-id>false</ask-for-group-id>
          <clear-selection-first>true</clear-selection-first>
        </frame>
        <frame>
          <name>subjectIds</name>
          <prompt>Select Subject/Participant Identifier</prompt>
          <mode>CategoryReplaceMissing</mode>
          <validators>
            <validator>NoMissingData</validator>
          </validators>
          <same-length-as>times</same-length-as>
          <min-columns>1</min-columns>
          <max-columns>1</max-columns>
          <ask-for-group-id>false</ask-for-group-id>
          <clear-selection-first>true</clear-selection-first>
        </frame>
        <frame>
          <name>groups</name>
          <prompt>Select Groups (skip if only one group)</prompt>
          <cancel-skips-parameter>Skip</cancel-skips-parameter>
          <same-length-as>times</same-length-as>
          <mode>CategoryReplaceMissing</mode>
          <min-columns>1</min-columns>
          <max-columns>1</max-columns>
          <ask-for-group-id>false</ask-for-group-id>
          <clear-selection-first>true</clear-selection-first>
        </frame>
      </parameters>
    <script language="CSharp"><![CDATA[
    bool hasZeroTime = false;
    foreach (double v in parameters["times"].AsDataFrame.Variables[0].AsDoubleVariable.Data)
      if (v == 0)
      {
        hasZeroTime = true;
        break;
      }
    ParameterBag outputParameters = new ParameterBag();
    outputParameters.AddOutput("hasZeroTime", hasZeroTime);
    return outputParameters;
    ]]></script>
    <test>
      <condition>=!(parameters["hasZeroTime"].AsBoolean)</condition>
      <iftrue>
          <parameters>
            <boolean>
              <name>addZeroObservationAtZeroTime</name>
              <prompt>Treat observation value at time zero as zero?</prompt>
            </boolean>
          </parameters>
      </iftrue>
    </test>
      <parameters>
        <confidence-interval>
          <name>ci</name>
        </confidence-interval>
        <boolean>
          <name>doExactP</name>
          <prompt>Bootstrap confidence intervals?</prompt>
          <must-request>true</must-request>
          <lifetime>SessionForThisOperation</lifetime>
          <default-value>true</default-value>
        </boolean>
        <integer>
          <name>iterations</name>
          <prompt>Iterations</prompt>
          <acquire-if-true>=parameters.ContainsKey("doExactP") &amp;&amp; parameters["doExactP"].AsBoolean</acquire-if-true>
          <must-request>true</must-request>
          <lifetime>SessionForThisOperation</lifetime>
          <minimum-value>1</minimum-value>
          <default-value>100000</default-value>
        </integer>
        <integer>
          <name>seed</name>
          <prompt>Seed</prompt>
          <acquire-if-true>=parameters.ContainsKey("doExactP") &amp;&amp; parameters["doExactP"].AsBoolean</acquire-if-true>
          <must-request>true</must-request>
          <force-default>true</force-default>
          <default-value>=Base.DefaultSeed()</default-value>
        </integer>
      </parameters>
    <builtin function-name="rptTimeSeriesSummary"/>
    <report type="application/x-statsdirect-creole">
      <![CDATA[
<report>
<line><title>Time series summary</title></line>
<block name="group">
<line></line>
<line><subtitle>Group: <in>groupName</in></subtitle></line>
<line></line>
<table>
<tr><th>Time</th><th>Observations</th><th>Mean</th><th>SD</th><th>SE</th><th>Median</th><th>IQR</th></tr>
<block name="time">
<tr><td><in>time</in></td><td><in>observations</in></td><td><inx>mean</inx></td><td><inx>sd</inx></td><td><inx>se</inx></td><td><inx>median</inx></td><td><inx>iqr</inx></td></tr>
</block>
</table>
<line></line>
<table>
<tr><th>Subject ID</th><th>Baseline</th><th>Min. observation</th><th>Max. observation</th><th>Time to max.</th><th>Slope to max.</th><th>AUC</th></tr>
<block name="subject">
<tr><td><in>subjectId</in></td><td><inx>baseline</inx></td><td><inx>min</inx></td><td><inx>max</inx></td><td><inx>timeToMax</inx></td><td><inx>slopeToMax</inx></td><td><inx>auc</inx></td></tr>
</block>
</table>
<line></line>
<line>Subjects: <in>subjects</in></line>
<line>Total (mean per time point) observations: <in>totalObservations</in> (<inx>meanObservationsPerTimePoint</inx>)</line>
<line>Mean (SD) area under curve (AUC): <inx>aucMean</inx> (<inx>aucSd</inx>)</line>
<line><ci><in>ciOutput</in>% t-interval for AUC: <inx>aucTLcl</inx> to <inx>aucTUcl</inx></ci></line>
<block name="bootstrap">
<line><ci><in>ciOutput</in>% bootstrap-t interval for AUC (<in>completedIterations</in> iterations, seed <in>seed</in>): <inx>aucTLclBoot</inx> to <inx>aucTUclBoot</inx></ci></line>
</block>
<line><ci><in>ciOutput</in>% z-interval for AUC: <inx>aucZLcl</inx> to <inx>aucZUcl</inx></ci></line>
<line>Median (IQR) area under curve: <inx>medianAuc</inx> (<inx>iqrAuc</inx>)</line>
<line>Median (IQR) time to maximum: <inx>medianTimeToMax</inx> (<inx>iqrTimeToMax</inx>)</line>
<line>Median (IQR) slope to maximum: <inx>medianSlopeToMax</inx> (<inx>iqrSlopeToMax</inx>)</line>
<line>Mean (SD) slope to maximum: <inx>meanSlopeToMax</inx> (<inx>meanSlopeToMaxSD</inx>)</line>
<line></line>
<line><in>chart</in></line>
</block>
<line></line>
<line><subtitle>AUC distribution</subtitle></line>
<line></line>
<line><in>aucNormalChart</in></line>
<line>R-square for AUC vs. normal scores: <inx>rSquareNormal</inx></line>
<line><in>aucLogNormalChart</in></line>
<line>R-square for log(AUC) vs. normal scores: <inx>rSquareLogNormal</inx></line>
<block name="groupComparison">
<line></line>
<line><subtitle>Group comparison: <in>group1Title</in> vs. <in>group2Title</in></subtitle></line>
<line></line>
<line>t (SE): <inx>t</inx> (<inx>se</inx>)</line>
<line>DF: <inx>df</inx></line>
<line><pval>Two sided <inp>p2</inp></pval></line>
<line><ci>AUC difference (<in>ciOutput</in>% CI): <inx>aucDifference</inx> (<inx>aucDifferenceLcl</inx> to <inx>aucDifferenceUcl</inx>)</ci></line>
<block name="bootstrap">
<line>Bootstrapped with <in>iterations</in> iterations, seed <in>seed</in></line>
<line><pval>Two sided bootstrap <inp>pBootstrap</inp></pval></line>
<line><ci><in>ciOutput</in>% bootstrap-t interval: <inx>tBootstrapLcl</inx> to <inx>tBootstrapUcl</inx></ci></line>
</block>
</block>
<line><in>meanAucChart</in></line>
<line></line>
</report>
]]>
    </report>
  </steps>
</operation>
