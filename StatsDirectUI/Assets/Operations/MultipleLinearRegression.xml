<?xml version="1.0" encoding="utf-8"?>
<operation xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns="http://www.statsdirect.com/schemas/Operation.xsd">
	<name>MultipleLinearRegression</name>
  <friendly-name lang="en-GB">Multiple (general) linear regression</friendly-name>
  <help chm-id="1277" />
  <steps>
    <settings>
			<parameters>
				<confidence-interval>
					<name>ci</name>
				</confidence-interval>
				<options>
					<name>options</name>
					<prompt>Multiple Linear Regression Options</prompt>
					<options>
						<option name="calculateIntercept" selected="true">Calculate intercept</option>
						<option name="useWeights">Use weights</option>
					</options>
				</options>
				<frame>
					<name>outcome</name>
					<prompt>Select data for OUTCOME (Y axis)</prompt>
					<mode>NumericReplaceMissing</mode>
					<min-columns>1</min-columns>
					<max-columns>1</max-columns>
					<clear-selection-first>true</clear-selection-first>
				</frame>
			</parameters>
		</settings>
		<test>
			<condition>=Parameters["useWeights"].AsBoolean</condition>
			<iftrue>
        <settings>
					<parameters>
						<frame>
							<name>weights</name>
							<prompt>Select data for WEIGHTS (Unweighted for unweighted)</prompt>
              <cancel-skips-parameter>Unweighted</cancel-skips-parameter>
              <mode>NumericReplaceMissing</mode>
							<min-columns>1</min-columns>
							<max-columns>1</max-columns>
							<same-length-as>outcome</same-length-as>
							<clear-selection-first>true</clear-selection-first>
						</frame>
					</parameters>
				</settings>
			</iftrue>
		</test>
    <settings>
			<parameters>
				<frame>
					<name>predictors</name>
					<prompt>Select data for PREDICTORS</prompt>
          <validator>CheckForNonDummiedCategories</validator>
          <mode>NumericCodingTextToCategories</mode>
					<min-columns>1</min-columns>
					<max-columns>200</max-columns>
					<same-length-as>outcome</same-length-as>
					<clear-selection-first>true</clear-selection-first>
				</frame>
			</parameters>
		</settings>
		<builtin function-name="rptMultipleLinearRegression" />
		<test>
			<condition>=Parameters["isPoly"].AsBoolean</condition>
			<iftrue>
				<report filename="poly.rtf" />
			</iftrue>
			<iffalse>
				<report filename="multi.rtf" />
			</iffalse>
		</test>
	</steps>
  <suggested-operations>
    <suggested-operation>MultipleLinearRegressionAnova</suggested-operation>
    <suggested-operation>MultipleLinearRegressionPrediction</suggested-operation>
    <suggested-operation>MultipleLinearRegressionBestSubset</suggested-operation>
    <suggested-operation>MultipleLinearRegressionResiduals</suggested-operation>
    <suggested-operation>Xxi</suggested-operation>
    <suggested-operation>MultipleLinearRegressionParameterDetail</suggested-operation>
    <suggested-operation>PlotMultipleLinearRegressionResiduals</suggested-operation>
  </suggested-operations>
</operation>
