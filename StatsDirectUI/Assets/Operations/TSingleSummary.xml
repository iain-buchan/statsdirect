<?xml version="1.0" encoding="utf-8"?>
<operation xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns="http://www.statsdirect.com/schemas/Operation.xsd">
	<name>TSingleSummary</name>
  <friendly-name lang="en-GB">Single sample Student t test from summary statistics</friendly-name>
  <help chm-id="1241" />
  <steps>
    <settings>
      <parameters>
        <integer>
          <name>nx</name>
          <prompt>Sample size</prompt>
          <minimum-value>1</minimum-value>
        </integer>
        <double>
          <name>mu</name>
          <prompt>Sample mean</prompt>
        </double>
        <double>
          <name>sd1</name>
          <prompt>Sample standard deviation</prompt>
        </double>
        <double>
          <name>mu0</name>
          <prompt>Population mean</prompt>
        </double>
        <confidence-interval>
          <name>gamma</name>
        </confidence-interval>
      </parameters>
    </settings>
	<builtin function-name="rptTSingleSummary" />
	<report filename="m_single.rtf" />
	</steps>
</operation>
