<?xml version="1.0" encoding="utf-8"?>
<operation xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns="http://www.statsdirect.com/schemas/Operation.xsd">
	<name>ExactFisherRbyC</name>
  <friendly-name lang="en-GB">R-by-c contingency table tests</friendly-name>
  <help chm-id="1055" />
  <steps>
    <settings>
      <parameters>
        <frame>
          <name>data</name>
          <prompt/>
          <must-request>true</must-request>
          <min-columns>1</min-columns>
          <max-columns>200</max-columns>
          <can-select>false</can-select>
        </frame>
        <confidence-interval>
          <name>cco</name>
        </confidence-interval>
        <boolean>
          <name>doExact</name>
          <prompt>Try exact test</prompt>
          <must-request>true</must-request>
          <column>2</column>
          <default-value>false</default-value>
        </boolean>
        <boolean>
          <name>show_pc</name>
          <prompt>Show percentages</prompt>
          <must-request>true</must-request>
          <column>2</column>
          <default-value>true</default-value>
        </boolean>
        <boolean>
          <name>xp</name>
          <prompt>Show expected counts</prompt>
          <must-request>true</must-request>
          <column>2</column>
          <default-value>false</default-value>
        </boolean>
        <boolean>
          <name>cs</name>
          <prompt>Show cell chi-square</prompt>
          <must-request>true</must-request>
          <column>2</column>
          <default-value>false</default-value>
        </boolean>
        <boolean>
          <name>xs</name>
          <prompt>Show trend scores</prompt>
          <must-request>true</must-request>
          <column>2</column>
          <default-value>false</default-value>
        </boolean>
        <boolean>
          <name>specify_scores</name>
          <prompt>Specify trend scores</prompt>
          <must-request>true</must-request>
          <column>2</column>
          <default-value>false</default-value>
        </boolean>
      </parameters>
    </settings>
  	<builtin function-name="rptChiRbyC" />
	  <report type="text/rtf" filename="chirxc.rtf" />
	</steps>
  <suggested-operations>
    <suggested-operation>ExactFisherRbyC</suggested-operation>
  </suggested-operations>
</operation>
