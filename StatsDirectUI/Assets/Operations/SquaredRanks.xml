<?xml version="1.0" encoding="utf-8"?>
<operation xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns="http://www.statsdirect.com/schemas/Operation.xsd">
	<name>SquaredRanks</name>
	<friendly-name lang="en-GB">Equality of variance (squared ranks)</friendly-name>
	<steps>
    <settings>
      <parameters>
        <confidence-interval>
          <name>confidence</name>
        </confidence-interval>
        <frame>
          <name>data</name>
          <prompt>Select DATA</prompt>
          <same-length>false</same-length>
          <mode>NumericReplaceMissing</mode>
          <min-columns>2</min-columns>
          <max-columns>200</max-columns>
          <ask-for-group-id>true</ask-for-group-id>
        </frame>
      </parameters>
    </settings>
		<builtin function-name="rptSqRank" />
		<test>
			<condition>=((StatsDirect.Data.DataFrame)Parameters["data"].Data).VariableCount > 2</condition>
			<iftrue>
				<report filename="sqrank.rtf" />
			</iftrue>
			<iffalse>
				<report filename="sqrank2.rtf" />
			</iffalse>
		</test>
	</steps>
</operation>
