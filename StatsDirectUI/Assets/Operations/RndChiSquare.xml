<?xml version="1.0" encoding="utf-8"?>
<operation xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns="http://www.statsdirect.com/schemas/Operation.xsd">
	<name>RndChiSquare</name>
  <friendly-name lang="en-GB">Random numbers: Chi-square</friendly-name>
  <help chm-id="1258" />
  <steps>
    <settings>
      <parameters>
        <integer>
          <name>cols</name>
          <prompt>How many columns to fill?</prompt>
          <minimum-value>1</minimum-value>
          <maximum-value>50</maximum-value>
          <default-value>1</default-value>
        </integer>
        <integer>
          <name>rows</name>
          <prompt>How many rows to fill?</prompt>
          <minimum-value>1</minimum-value>
          <maximum-value>65000</maximum-value>
          <default-value>100</default-value>
        </integer>
        <double>
          <name>df</name>
          <prompt>Degrees of freedom</prompt>
          <minimum-value>0</minimum-value>
          <default-value>2</default-value>
        </double>
        <integer>
          <name>seed</name>
          <prompt>Seed for random number generator</prompt>
          <default-value>=Base.defaultseed()</default-value>
        </integer>
      </parameters>
    </settings>
  	<builtin function-name="shtRndChiSquare" />
	  <output-frame frame-name="output" prefer-in-place-insertion="true"/>
	</steps>
</operation>
