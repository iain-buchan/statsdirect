<?xml version="1.0" encoding="utf-8"?>
<operation xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns="http://www.statsdirect.com/schemas/Operation.xsd">
	<name>MultipleLinearRegressionAnova</name>
	<friendly-name lang="en-GB">Analysis of variance from regression</friendly-name>
  <prerequisite-operation>MultipleLinearRegression</prerequisite-operation>
  <steps>
    <settings>
			<parameters>
				<confidence-interval>
					<name>ci</name>
          <must-request>true</must-request>
        </confidence-interval>
			</parameters>
		</settings>
		<builtin function-name="rptMultipleLinearRegressionAnova" />
		<report filename="glranova.rtf" />
	</steps>
</operation>
