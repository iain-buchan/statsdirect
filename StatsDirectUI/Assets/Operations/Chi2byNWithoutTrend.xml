<?xml version="1.0" encoding="utf-8"?>
<operation xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns="http://www.statsdirect.com/schemas/Operation.xsd">
	<name>Chi2byNWithoutTrend</name>
  <friendly-name lang="en-GB">Chi-square 2-by-k independence test</friendly-name>
  <help chm-id="1049" />
  <steps>
    <settings>
      <parameters>
        <special>
          <name>data</name>
          <must-request>true</must-request>
          <validators>
            <validator>NoMissingData</validator>
            <validator>TwoColumns</validator>
          </validators>
          <type>chi-2-column</type>
        </special>
      </parameters>
    </settings>
  	<builtin function-name="rptChi2byNWithoutTrend" />
	  <report type="text/rtf" filename="chi2xc.rtf" />
	</steps>
  <custom-validators>
    <validator name="TwoColumns" language="CSharp">
      return (parameters[parameter.Name].IsDataFrame &amp;&amp; parameters[parameter.Name].AsDataFrame.VariableCount == 2) ? null : "Values should be entered in both columns";
    </validator>
  </custom-validators>
  <suggested-operations>
    <suggested-operation>Chi2byNWithoutTrend</suggested-operation>
  </suggested-operations>
</operation>
