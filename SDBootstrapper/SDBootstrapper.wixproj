<Project>
  <Import Project="Sdk.props" Sdk="WixToolset.Sdk" Version="4.0.0" />
  <PropertyGroup>
    <ProductVersion>3.7</ProductVersion>
    <OutputName>StatsDirectSetup</OutputName>
    <OutputType>Bundle</OutputType>
    <SignOutput>true</SignOutput>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Debug|x86' ">
    <DefineConstants>Debug</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="WixToolset.NetFx.wixext" Version="4.0.0" />
    <PackageReference Include="WixToolset.Util.wixext" Version="4.0.0" />
    <PackageReference Include="WixToolset.Bal.wixext" Version="4.0.0" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="bannrbmp-sd.png" />
    <Content Include="dlgbmp-sd.png" />
    <Content Include="greybar.png" />
    <Content Include="Licence.rtf" />
    <Content Include="sd3.ico" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\SDInstaller\SDInstaller-standalone-x64.wixproj" />
  </ItemGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'ReleaseWithSigning|x86' ">
    <IntermediateOutputPath>obj\$(Platform)\$(Configuration)\</IntermediateOutputPath>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'ReleaseWithSigning|AnyCPU' ">
    <OutputPath>bin\$(Platform)\$(Configuration)\</OutputPath>
    <IntermediateOutputPath>obj\$(Platform)\$(Configuration)\</IntermediateOutputPath>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'ReleaseWithSigning|Any CPU' ">
    <OutputPath>bin\$(Platform)\$(Configuration)\</OutputPath>
    <IntermediateOutputPath>obj\$(Platform)\$(Configuration)\</IntermediateOutputPath>
  </PropertyGroup>
  <Target Name="SignBundleEngine">
    <Exec Command="&quot;$(SolutionDir)Key\signtool\signtool.exe&quot; sign /f &quot;$(SolutionDir)Key\sdsign.pfx&quot; /p ***REMOVED*** /t http://timestamp.digicert.com /d &quot;%(SignBundleEngine.Filename)&quot; &quot;@(SignBundleEngine)&quot;" />
  </Target>
  <Target Name="SignBundle">
    <Exec Command="rem &quot;$(SolutionDir)Key\signtool\signtool.exe&quot; sign /f &quot;$(SolutionDir)Key\sd_sign_sha2.pfx&quot; /fd sha256 /p ***REMOVED*** /tr http://timestamp.digicert.com /td sha256 /as /d &quot;%(SignBundle.Filename)&quot; &quot;@(SignBundle)&quot;" />
  </Target>
  <Target Name="SignMsi">
    <Exec Command="rem &quot;$(SolutionDir)Key\signtool\signtool.exe&quot; sign /f &quot;$(SolutionDir)Key\sd_sign_sha2.pfx&quot; /p ***REMOVED*** /t http://timestamp.digicert.com /d &quot;%(SignMsi.Filename)&quot; &quot;@(SignMsi)&quot;" />
  </Target>
  <Target Name="SignCabs">
    <Exec Command="rem &quot;$(SolutionDir)Key\signtool\signtool.exe&quot; sign /f &quot;$(SolutionDir)Key\sd_sign_sha2.pfx&quot; /p ***REMOVED*** /t http://timestamp.digicert.com /d &quot;%(SignCabs.Filename)&quot; &quot;@(SignCabs)&quot;" />
  </Target>
  <Import Project="Sdk.targets" Sdk="WixToolset.Sdk" Version="4.0.0" />
  <PropertyGroup>
    <PostBuildEvent>if $(ConfigurationName) == ReleaseWithSigning copy "$(TargetPath)" "$(SolutionDir)ReleaseBuild"</PostBuildEvent>
  </PropertyGroup>
</Project>