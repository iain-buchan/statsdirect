<Project Sdk="WixToolset.Sdk/6.0.2">
  <PropertyGroup>
    <Platform>x64</Platform>
    <ProductVersion>5.0</ProductVersion>
    <OutputName>StatsDirectSetup</OutputName>
    <OutputType>Bundle</OutputType>
    <OutputPath>..\ReleaseBuild</OutputPath>
    <Configurations>Debug;Release;ReleaseWithSigning</Configurations>
    <!-- Only ReleaseWithSigning signs: Release must build on a machine that has no signing key. StatsDirectUI.slnx passes the solution's Release and ReleaseWithSigning configurations straight through to this project. -->
    <SignOutput Condition="'$(Configuration)' == 'ReleaseWithSigning'">true</SignOutput>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="WixToolset.NetFx.wixext" Version="6.0.2" />
    <PackageReference Include="WixToolset.Util.wixext" Version="6.0.2" />
    <PackageReference Include="WixToolset.Bal.wixext" Version="6.0.2" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="bannrbmp-sd.png" />
    <Content Include="dlgbmp-sd.png" />
    <Content Include="greybar.png" />
    <Content Include="Licence.rtf" />
    <Content Include="statsdirect.ico" />
    <Content Include="statsdirect.png" />
    <Content Include="Theme.xml" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\SDInstaller\SDInstaller-standalone-x64.wixproj" />
  </ItemGroup>
  <Target Name="SignBundleEngine">
    <Exec Command="..\Key\sign.cmd &quot;%(SignBundleEngine.FullPath)&quot;" />
  </Target>
  <Target Name="SignBundle">
    <Exec Command="..\Key\sign.cmd &quot;%(SignBundle.FullPath)&quot;" />
  </Target>
</Project>