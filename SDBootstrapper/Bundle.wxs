<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi"
     xmlns:bal="http://schemas.microsoft.com/wix/BalExtension"
     xmlns:netfx="http://schemas.microsoft.com/wix/NetFxExtension">
  <Bundle
    Name="StatsDirect"
    Version="!(bind.packageVersion.MsiForVersionNumber)"
    Manufacturer="StatsDirect Limited"
    UpgradeCode="e52fa35e-33b1-45d2-b004-cfc5cc7c7ef5"
    DisableModify="yes"
    Copyright="Copyright ©1995-2023 StatsDirect Limited. All rights reserved."
    HelpUrl="http://www.statsdirect.com/Support.aspx"
    UpdateUrl="http://www.statsdirect.com/Update.aspx"
    IconSourceFile="sd3.ico">
    <bal:Condition Message="User Account Control appears to be disabled on this computer. You need either to enable it or to be an administrator to install StatsDirect.">Privileged</bal:Condition>
    <BootstrapperApplicationRef Id="WixStandardBootstrapperApplication.RtfLicense">
      <bal:WixStandardBootstrapperApplication ThemeFile="Theme.xml"
            LicenseFile="Licence.rtf"
            />
      <Payload SourceFile="dlgbmp-sd.png" />
      <Payload SourceFile="bannrbmp-sd.png" />
      <Payload SourceFile="greybar.png" />
    </BootstrapperApplicationRef>
    <Chain>
      <PackageGroupRef Id="NetFx461Web"/>
      <MsiPackage Id="MsiForVersionNumber" Compressed="yes" SourceFile="$(var.SDInstaller-x86.TargetPath)" Vital="yes" DisplayInternalUI="no" InstallCondition="NOT VersionNT64" ForcePerMachine="yes" />
      <MsiPackage Compressed="yes" SourceFile="$(var.SDInstaller-x64.TargetPath)" Vital="yes" DisplayInternalUI="no" InstallCondition="VersionNT64" ForcePerMachine="yes" />
    </Chain>
  </Bundle>
</Wix>