<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs" xmlns:bal="http://wixtoolset.org/schemas/v4/wxs/bal">
  <Bundle Name="StatsDirect" Version="!(bind.packageVersion.MsiForVersionNumber)" Manufacturer="StatsDirect Limited" UpgradeCode="e52fa35e-33b1-45d2-b004-cfc5cc7c7ef5" DisableModify="yes" Copyright="Copyright ©1995-2023 StatsDirect Limited. All rights reserved." HelpUrl="http://www.statsdirect.com/Support.aspx" UpdateUrl="http://www.statsdirect.com/Update.aspx" IconSourceFile="sd3.ico">
    <bal:Condition Message="User Account Control appears to be disabled on this computer. You need either to enable it or to be an administrator to install StatsDirect." Condition="Privileged" />
    <BootstrapperApplication>
      <bal:WixStandardBootstrapperApplication ThemeFile="Theme.xml" LicenseFile="Licence.rtf" Theme="rtfLicense" />
      <Payload SourceFile="dlgbmp-sd.png" />
      <Payload SourceFile="bannrbmp-sd.png" />
      <Payload SourceFile="greybar.png" />
    </BootstrapperApplication>
    <Chain>
      <PackageGroupRef Id="NetFx462Web" />
      <MsiPackage Id="MsiForVersionNumber" Compressed="yes" SourceFile="$(var.SDInstaller-standalone-x64.TargetPath)" Vital="yes" InstallCondition="VersionNT64" ForcePerMachine="yes" />
    </Chain>
  </Bundle>
</Wix>