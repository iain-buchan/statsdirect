<Wix
  xmlns="http://wixtoolset.org/schemas/v4/wxs"
  xmlns:bal="http://wixtoolset.org/schemas/v4/wxs/bal"
  xmlns:netfx="http://wixtoolset.org/schemas/v4/wxs/netfx">
  <!-- The .Net Windows Desktop runtime bundled into the setup executable. To move to a newer one, change this version and download the matching installer: see DownloadedBinaries/README.md. -->
  <?define DotNetDesktopRuntimeVersion = "10.0.12" ?>
  <?define DotNetDesktopRuntimeInstaller = "windowsdesktop-runtime-$(DotNetDesktopRuntimeVersion)-win-x64.exe" ?>
  <Bundle
    Name="StatsDirect"
    Version="!(bind.packageVersion.StatsDirectMsi)"
    Manufacturer="StatsDirect Limited"
    UpgradeCode="e52fa35e-33b1-45d2-b004-cfc5cc7c7ef5"
    DisableModify="yes"
    Copyright="Copyright ©1995-2025 StatsDirect Limited. All rights reserved."
    HelpUrl="http://www.statsdirect.com/Support.aspx"
    UpdateUrl="http://www.statsdirect.com/Update.aspx"
    IconSourceFile="statsdirect.ico"
    >
    <!-- <bal:Condition Message="User Account Control appears to be disabled on this computer. You need either to enable it or to be an administrator to install StatsDirect." Condition="Privileged" /> -->
    <BootstrapperApplication>
      <bal:WixStandardBootstrapperApplication
        LicenseFile="Licence.rtf"
        LogoFile="statsdirect.png"
        Theme="rtfLicense" />
      <Payload SourceFile="bannrbmp-sd.png" />
      <Payload SourceFile="dlgbmp-sd.png" />
      <Payload SourceFile="greybar.png" />
      <Payload SourceFile="statsdirect.png" />
    </BootstrapperApplication>
    <Chain>
      <PackageGroupRef Id="DotNetDesktopRedist" />
      <MsiPackage
        Id="StatsDirectMsi"
        Compressed="yes"
        SourceFile="StatsDirect-x64.msi"
        />
    </Chain>
  </Bundle>

  <Fragment>
    <netfx:DotNetCoreSearch RuntimeType="desktop" MajorVersion="10" Platform="x64" Variable="DOTNETDESKTOPVERSION" />
    <PackageGroup Id="DotNetDesktopRedist">
      <ExePackage
        Id="DotNetDesktop"
        DetectCondition="DOTNETDESKTOPVERSION &gt;= &quot;10.0.0&quot;"
        InstallArguments="$(DotNetDesktopRuntimeInstaller) /install /quiet /norestart"
        RepairArguments="$(DotNetDesktopRuntimeInstaller) /repair /quiet /norestart"
        UninstallArguments="$(DotNetDesktopRuntimeInstaller) /uninstall /quiet /norestart">
        <ExePackagePayload
          Name="$(DotNetDesktopRuntimeInstaller)"
          SourceFile="..\DownloadedBinaries\$(DotNetDesktopRuntimeInstaller)"
          />
      </ExePackage>
    </PackageGroup>
  </Fragment>
</Wix>